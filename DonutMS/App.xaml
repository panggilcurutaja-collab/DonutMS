<Application x:Class="DonutMS.App"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:local="clr-namespace:DonutMS"
xmlns:converters="clr-namespace:DonutMS.Resources.Converters"
xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DonutMS;component/Resources/Styles/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom Converters -->
            <converters:BoolToWidthConverter x:Key="BoolToWidthConverter" />
            <converters:CurrencyConverter x:Key="CurrencyConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:IconToGlyphConverter x:Key="IconToGlyphConverter" />
            <converters:IconToPackIconMaterialKindConverter x:Key="IconToPackIconMaterialKindConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
