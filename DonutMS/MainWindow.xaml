<mah:MetroWindow x:Class="DonutMS.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
                 Title="Donut Management System"
                 Height="760"
                 Width="1280"
                 MinHeight="680"
                 MinWidth="1080"
                 WindowStartupLocation="CenterScreen"
                 ShowIconOnTitleBar="False"
                 TitleCharacterCasing="Normal"
                 FontFamily="Segoe UI Variable"
                 Loaded="MetroWindow_Loaded">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="20,14"
                BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FF1E3A8A" />
                    <GradientStop Offset="1" Color="#FF0EA5E9" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleMenuCommand}"
                            Style="{StaticResource MahApps.Styles.Button.Square}"
                            Width="38"
                            Height="38"
                            Background="#30FFFFFF"
                            BorderThickness="0"
                            Foreground="White"
                            Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="Menu" Width="18" Height="18" />
                    </Button>
                    <StackPanel>
                        <TextBlock Text="{Binding ApplicationTitle}"
                                   Foreground="{DynamicResource HeaderForegroundBrush}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Operations, costing, and production in one workspace"
                                   Foreground="{DynamicResource HeaderForegroundBrush}"
                                   FontSize="12"
                                   Opacity="0.82" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Command="{Binding OpenRegisterCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Padding="14,7"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AccountPlus" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="Register User" Foreground="White" />
                        </StackPanel>
                    </Button>

                    <Border Background="#22FFFFFF"
                            BorderBrush="#45FFFFFF"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUser.FullName, StringFormat='Welcome, {0}'}"
                                       Foreground="{DynamicResource HeaderForegroundBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentUser.Role}"
                                       Foreground="{DynamicResource HeaderForegroundBrush}"
                                       FontSize="11"
                                       Opacity="0.85" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource NavigationBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Width="{Binding IsMenuOpen, Converter={StaticResource BoolToWidthConverter}, ConverterParameter='268,64'}"
                    d:Width="268">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="Navigation"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding NavigationViewModel.MenuItems}"
                             Margin="8,10,8,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigateToMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource NavigationButtonStyle}"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Kind="{Binding Icon, Converter={StaticResource IconToPackIconMaterialKindConverter}}"
                                                                    Foreground="{DynamicResource AccentBrush}"
                                                                    Width="18"
                                                                    Height="18"
                                                                    Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Label}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Margin="10,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource MaterialDesignPaper}"
                    Padding="16">
                <Border Style="{StaticResource ModernCardStyle}"
                        CornerRadius="14"
                        Padding="0">
                    <ContentControl x:Name="ContentArea"
                                    Background="Transparent" />
                </Border>
            </Border>
        </Grid>
    </Grid>
</mah:MetroWindow>
