<mah:MetroWindow x:Class="DonutMS.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/materialdesign"
                xmlns:local="clr-namespace:DonutMS"
                mc:Ignorable="d"
                Title="Donut Management System"
                Height="720"
                Width="1200"
                WindowStartupLocation="CenterScreen"
                ShowIconOnTitleBar="False"
                TitleCharacterCasing="Normal"
                Background="{DynamicResource MaterialDesignPaper}"
                TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                TextElement.FontWeight="Regular"
                TextElement.FontSize="13"
                FontFamily="pack://application:,,,/MaterialDesignThemes.Wpf;component/Resources/Roboto/#Roboto"
                Loaded="MetroWindow_Loaded">

    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design Theme -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/Materialdesign3.Defaults.xaml" />
                
                <!-- MahApps Metro Core -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource PrimaryHueMidBrush}"
                Padding="16,8"
                BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

            <!-- Menu Toggle & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleMenuCommand}" 
                            Style="{StaticResource MahApps.Styles.Button.Square}"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="White"
                            Margin="0">
                        <TextBlock Text="☰" Foreground="White" FontSize="20" />
                    </Button>
                    <TextBlock Text="{Binding ApplicationTitle}"
                              Foreground="White"
                              FontSize="18"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0" />
                </StackPanel>

                <!-- User Info & Theme Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="{Binding CurrentUser.FullName, StringFormat='Welcome, {0}'}"
                                  Foreground="White"
                                  FontSize="12"
                                  FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentUser.Role}"
                                  Foreground="White"
                                  FontSize="11"
                                  Opacity="0.8" />
                    </StackPanel>

                    <Button Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource MahApps.Styles.Button.Square}"
                            Width="40"
                            Height="40"
                            Background="Transparent"
                            Foreground="White"
                            ToolTip="Toggle Theme"
                            Margin="8,0,0,0">
                        <TextBlock Text="🌙" Foreground="White" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Collapsible Sidebar Menu -->
            <Border Grid.Column="0"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0"
                    Width="{Binding IsMenuOpen, Converter={StaticResource BoolToWidthConverter}, ConverterParameter='250,50'}"
                    d:Width="250">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Menu Header -->
                    <TextBlock Grid.Row="0"
                              Text="Navigation"
                              Padding="16,12"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                              Background="{DynamicResource MaterialDesignDividerBackground}" />

                    <!-- Menu Items List -->
                    <ListBox Grid.Row="1"
                            ItemsSource="{Binding NavigationViewModel.MenuItems}"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NavigationViewModel.NavigateToMenuCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource MahApps.Styles.Button}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{DynamicResource MaterialDesignBody}"
                                        Padding="16,12"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" Foreground="DodgerBlue" FontSize="14" Width="16" TextAlignment="Center" />
                                        <TextBlock Text="{Binding Label}"
                                                  VerticalAlignment="Center"
                                                  FontSize="13"
                                                  Margin="12,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Page Content Frame -->
            <ContentControl Grid.Column="1"
                           Content="{Binding CurrentViewModel}"
                           Padding="20"
                           Background="{DynamicResource MaterialDesignPaper}" />
        </Grid>
    </Grid>
</mah:MetroWindow>
