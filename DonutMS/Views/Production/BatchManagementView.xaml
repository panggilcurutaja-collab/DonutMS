<UserControl x:Class="DonutMS.Views.Production.BatchManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <materialDesign:DialogHost IsOpen="{Binding IsJobSheetOpen}">
        <materialDesign:DialogHost.DialogContent>
            <Border Background="{DynamicResource MaterialDesignCardBackground}"
                    Padding="16"
                    CornerRadius="6"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    Width="800"
                    MaxHeight="600">
                <StackPanel>
                    <TextBlock Text="{Binding JobSheetTitle}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource MaterialDesignBody}" />

                    <TextBlock Text="{Binding SelectedBatch.RecipeName, StringFormat='Recipe: {0}'}"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBlock Text="{Binding SelectedBatch.TargetYield, StringFormat='Target Yield: {0:N2}'}"
                               Foreground="{DynamicResource MaterialDesignBody}" />

                    <TextBlock Text="Ingredients" FontWeight="SemiBold" Margin="0,12,0,6" />
                    <DataGrid ItemsSource="{Binding SelectedBatch.Ingredients}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="White"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource DividerBrush}"
                              RowBackground="{DynamicResource MaterialDesignPaper}"
                              AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ingredient" Binding="{Binding IngredientName}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="Planned" Binding="{Binding PlannedQuantity, StringFormat=N2}" Width="90" IsReadOnly="True" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding PlannedUnitCode}" Width="70" IsReadOnly="True" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Command="{Binding CloseJobSheetCommand}"
                                Content="Close"
                                Padding="12,6"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </materialDesign:DialogHost.DialogContent>

        <Grid Background="{DynamicResource MaterialDesignPaper}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Production Batch Dashboard"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialDesignBody}"
                       Margin="0,0,0,16" />

            <Border Grid.Row="1"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    Padding="16"
                    CornerRadius="4"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Batches" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                        <TextBlock Text="{Binding TotalBatches}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Planned" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                        <TextBlock Text="{Binding PlannedCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="In Progress" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                        <TextBlock Text="{Binding InProgressCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Completed" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                        <TextBlock Text="{Binding CompletedCount}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <DatePicker SelectedDate="{Binding FromDate}" Background="White" />
                        <DatePicker SelectedDate="{Binding ToDate}" Background="White" Margin="8,0,0,0" />
                        <Button Command="{Binding LoadBatchesCommand}"
                                Content="Load"
                                Padding="12,6"
                                Background="{DynamicResource PrimaryHueMidBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="8,0,0,0" />
                        <Button Command="{Binding RefreshBatchesCommand}"
                                Content="Refresh"
                                Padding="12,6"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Create + Job List -->
                <StackPanel Grid.Column="0">
                    <Border Background="{DynamicResource MaterialDesignCardBackground}"
                            Padding="16"
                            CornerRadius="4"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Create New Batch" FontSize="14" FontWeight="SemiBold" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableRecipes}"
                                          SelectedItem="{Binding SelectedRecipe}"
                                          DisplayMemberPath="Name"
                                          Background="White"
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                          Margin="0,0,12,0"
                                          mah:TextBoxHelper.Watermark="Select recipe" />

                                <TextBox Grid.Column="1"
                                         Text="{Binding TargetYield, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         Background="White"
                                         Foreground="{DynamicResource MaterialDesignBody}"
                                         BorderBrush="{DynamicResource DividerBrush}"
                                         BorderThickness="1"
                                         Margin="0,0,12,0"
                                         mah:TextBoxHelper.Watermark="Target yield" />

                                <Button Grid.Column="2"
                                        Command="{Binding CreateBatchCommand}"
                                        Content="Create"
                                        Padding="12,6"
                                        Background="Green"
                                        Foreground="White"
                                        BorderThickness="0" />
                            </Grid>

                            <TextBlock Text="{Binding SelectedRecipe.YieldPerBatch, StringFormat='Recipe Yield: {0:N2}'}"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       FontSize="11"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Job List" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding Batches}"
                              SelectedItem="{Binding SelectedBatch}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              Background="White"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                              BorderThickness="1"
                              BorderBrush="{DynamicResource DividerBrush}"
                              RowBackground="{DynamicResource MaterialDesignPaper}"
                              AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Batch" Binding="{Binding BatchCode}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="Recipe" Binding="{Binding RecipeName}" Width="160" IsReadOnly="True" />
                            <DataGridTextColumn Header="Date" Binding="{Binding ProductionDate, StringFormat=dd MMM yyyy}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Target" Binding="{Binding TargetYield, StringFormat=N2}" Width="80" IsReadOnly="True" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding YieldUnitCode}" Width="60" IsReadOnly="True" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Actions" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectBatchCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding .}"
                                                Content="Details"
                                                Padding="8,4"
                                                FontSize="11"
                                                Background="{DynamicResource PrimaryHueMidBrush}"
                                                Foreground="White"
                                                BorderThickness="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Right Panel: Details, Execution, QC, Traceability -->
                <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                Padding="16"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedBatch.BatchCode, FallbackValue='Select a batch'}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesignBody}" />
                                <TextBlock Text="{Binding SelectedBatch.RecipeName, StringFormat='Recipe: {0}'}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           FontSize="11"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SelectedBatch.Status, StringFormat='Status: {0}'}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SelectedBatch.TargetYield, StringFormat='Target: {0:N2}'}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SelectedBatch.ActualYield, StringFormat='Actual: {0:N2}'}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding SelectedBatch.WasteQuantity, StringFormat='Waste: {0:N2}'}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding YieldVariance, StringFormat='Variance: {0:N2}'}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="{Binding YieldVariancePercent, StringFormat='Variance %: {0:N1}%'}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                Padding="16"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Actions" FontSize="13" FontWeight="SemiBold" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Command="{Binding StartProductionCommand}"
                                            Content="Start Production"
                                            Padding="12,6"
                                            Background="DodgerBlue"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="0,0,8,0" />
                                    <Button Command="{Binding OpenJobSheetCommand}"
                                            Content="Generate Job Sheet"
                                            Padding="12,6"
                                            Background="{DynamicResource PrimaryHueMidBrush}"
                                            Foreground="White"
                                            BorderThickness="0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                Padding="16"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Material Requirements" FontSize="13" FontWeight="SemiBold" />
                                <DataGrid ItemsSource="{Binding SelectedBatch.Ingredients}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          Background="White"
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                          TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource DividerBrush}"
                                          RowBackground="{DynamicResource MaterialDesignPaper}"
                                          AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}"
                                          Margin="0,8,0,0">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ingredient" Binding="{Binding IngredientName}" Width="160" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Planned" Binding="{Binding PlannedQuantity, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Unit" Binding="{Binding PlannedUnitCode}" Width="60" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Actual" Binding="{Binding ActualQuantity, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                Padding="16"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Batch Execution" FontSize="13" FontWeight="SemiBold" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBox Text="{Binding ActualYield, UpdateSourceTrigger=PropertyChanged}"
                                             Width="120"
                                             Padding="8,6"
                                             Background="White"
                                             Foreground="{DynamicResource MaterialDesignBody}"
                                             BorderBrush="{DynamicResource DividerBrush}"
                                             BorderThickness="1"
                                             Margin="0,0,8,0"
                                             mah:TextBoxHelper.Watermark="Actual yield" />
                                    <TextBox Text="{Binding WasteQuantityInput, UpdateSourceTrigger=PropertyChanged}"
                                             Width="120"
                                             Padding="8,6"
                                             Background="White"
                                             Foreground="{DynamicResource MaterialDesignBody}"
                                             BorderBrush="{DynamicResource DividerBrush}"
                                             BorderThickness="1"
                                             Margin="0,0,8,0"
                                             mah:TextBoxHelper.Watermark="Waste" />
                                    <Button Command="{Binding CompleteBatchCommand}"
                                            Content="Complete Batch"
                                            Padding="12,6"
                                            Background="Green"
                                            Foreground="White"
                                            BorderThickness="0" />
                                </StackPanel>

                                <TextBox Text="{Binding ExecutionNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,8,0,0"
                                         Padding="8,6"
                                         Background="White"
                                         Foreground="{DynamicResource MaterialDesignBody}"
                                         BorderBrush="{DynamicResource DividerBrush}"
                                         BorderThickness="1"
                                         AcceptsReturn="True"
                                         Height="70"
                                         mah:TextBoxHelper.Watermark="Execution notes / issues" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                Padding="16"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Quality Control" FontSize="13" FontWeight="SemiBold" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBox Text="{Binding QcInspectedBy, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6"
                                                 Background="White"
                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                 BorderBrush="{DynamicResource DividerBrush}"
                                                 BorderThickness="1"
                                                 mah:TextBoxHelper.Watermark="Inspected by" />

                                        <TextBox Text="{Binding QcTaste, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,6,0,0"
                                                 Padding="8,6"
                                                 Background="White"
                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                 BorderBrush="{DynamicResource DividerBrush}"
                                                 BorderThickness="1"
                                                 mah:TextBoxHelper.Watermark="Taste (0-10)" />

                                        <TextBox Text="{Binding QcTexture, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,6,0,0"
                                                 Padding="8,6"
                                                 Background="White"
                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                 BorderBrush="{DynamicResource DividerBrush}"
                                                 BorderThickness="1"
                                                 mah:TextBoxHelper.Watermark="Texture (0-10)" />

                                        <TextBox Text="{Binding QcAppearance, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,6,0,0"
                                                 Padding="8,6"
                                                 Background="White"
                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                 BorderBrush="{DynamicResource DividerBrush}"
                                                 BorderThickness="1"
                                                 mah:TextBoxHelper.Watermark="Appearance (0-10)" />

                                        <TextBox Text="{Binding QcAroma, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,6,0,0"
                                                 Padding="8,6"
                                                 Background="White"
                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                 BorderBrush="{DynamicResource DividerBrush}"
                                                 BorderThickness="1"
                                                 mah:TextBoxHelper.Watermark="Aroma (0-10)" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBox Text="{Binding QcDefectsFound, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6"
                                                 Background="White"
                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                 BorderBrush="{DynamicResource DividerBrush}"
                                                 BorderThickness="1"
                                                 Height="70"
                                                 AcceptsReturn="True"
                                                 mah:TextBoxHelper.Watermark="Defects found" />

                                        <TextBox Text="{Binding QcRemarks, UpdateSourceTrigger=PropertyChanged}"
                                                 Margin="0,6,0,0"
                                                 Padding="8,6"
                                                 Background="White"
                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                 BorderBrush="{DynamicResource DividerBrush}"
                                                 BorderThickness="1"
                                                 Height="70"
                                                 AcceptsReturn="True"
                                                 mah:TextBoxHelper.Watermark="Remarks / follow-up" />

                                        <Button Command="{Binding SubmitQualityControlCommand}"
                                                Content="Submit QC"
                                                Padding="12,6"
                                                Background="{DynamicResource PrimaryHueMidBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="QC History" FontWeight="SemiBold" Margin="0,12,0,6" />
                                <DataGrid ItemsSource="{Binding SelectedBatch.QualityControls}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          Background="White"
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                          TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource DividerBrush}"
                                          RowBackground="{DynamicResource MaterialDesignPaper}"
                                          AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding InspectionDate, StringFormat=dd MMM yyyy HH:mm}" Width="150" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Inspector" Binding="{Binding InspectedBy}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Taste" Binding="{Binding Taste}" Width="60" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Texture" Binding="{Binding Texture}" Width="70" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Appearance" Binding="{Binding Appearance}" Width="80" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Aroma" Binding="{Binding Aroma}" Width="70" IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Header="Pass" Binding="{Binding Passed}" Width="60" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                Padding="16"
                                CornerRadius="4"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Lot Traceability" FontSize="13" FontWeight="SemiBold" />
                                <DataGrid ItemsSource="{Binding BatchTransactions}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          Background="White"
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                          TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                          BorderThickness="1"
                                          BorderBrush="{DynamicResource DividerBrush}"
                                          RowBackground="{DynamicResource MaterialDesignPaper}"
                                          AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}"
                                          Margin="0,8,0,0">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ingredient" Binding="{Binding IngredientName}" Width="160" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Unit" Binding="{Binding UnitCode}" Width="60" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Lot" Binding="{Binding StockBatchNumber}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat=dd MMM yyyy HH:mm}" Width="150" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="3"
                    Background="{DynamicResource MaterialDesignDividerBackground}"
                    Padding="12,8"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Tomato" FontSize="12" />
                    </StackPanel>

                    <mah:ProgressRing Grid.Column="1"
                                      IsActive="{Binding IsLoading}"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </Grid>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>
