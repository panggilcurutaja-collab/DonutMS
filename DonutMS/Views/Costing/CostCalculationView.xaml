<UserControl x:Class="DonutMS.Views.Costing.CostCalculationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryHueMidBrush}"
                Padding="20,16"
                BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                BorderThickness="0,0,0,2">
            <StackPanel>
                <TextBlock Text="Cost Calculation Engine"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="Material cost, waste factor, and HPP per unit"
                           Foreground="White"
                           Opacity="0.9"
                           FontSize="12"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Inputs -->
        <Border Grid.Row="1"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="16"
                Margin="16,16,16,8"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Recipe"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Waste %"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Packaging (per batch)"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Labor (per batch)"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Overhead (per batch)"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />

                <ComboBox Grid.Row="1" Grid.Column="0"
                          ItemsSource="{Binding Recipes}"
                          SelectedItem="{Binding SelectedRecipe}"
                          DisplayMemberPath="Name"
                          Margin="0,6,12,0"
                          Background="{DynamicResource SurfaceBrush}"
                          Foreground="{DynamicResource MaterialDesignBody}"
                          Padding="10,6" />

                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding WastePercent, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,12,0"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource MaterialDesignBody}"
                         Padding="10,6" />

                <TextBox Grid.Row="1" Grid.Column="2"
                         Text="{Binding PackagingCost, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,12,0"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource MaterialDesignBody}"
                         Padding="10,6" />

                <TextBox Grid.Row="1" Grid.Column="3"
                         Text="{Binding LaborCost, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,12,0"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource MaterialDesignBody}"
                         Padding="10,6" />

                <TextBox Grid.Row="1" Grid.Column="4"
                         Text="{Binding OverheadCost, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,0"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource MaterialDesignBody}"
                         Padding="10,6" />
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,8">
            <Button Command="{Binding ResetInputsCommand}"
                    Content="Reset"
                    Padding="14,8"
                    Background="{DynamicResource SurfaceAltBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="0,0,8,0" />
            <Button Command="{Binding CalculateCommand}"
                    Content="Calculate"
                    Padding="16,8"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    Foreground="White"
                    BorderThickness="0" />
        </StackPanel>

        <!-- Summary + Ingredients -->
        <Grid Grid.Row="3" Margin="16,0,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        Padding="16"
                        CornerRadius="4"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Material Cost (Batch)" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock Text="{Binding MaterialCost, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        Padding="16"
                        CornerRadius="4"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Cost (Batch)" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock Text="{Binding TotalCost, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        Padding="16"
                        CornerRadius="4"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="HPP Per Unit" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock Text="{Binding HppPerUnit, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Background="{DynamicResource MaterialDesignCardBackground}"
                        Padding="16"
                        CornerRadius="4"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Yield / Batch" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        <TextBlock Text="{Binding YieldPerBatch, StringFormat=N2}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding IngredientCosts}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="{DynamicResource SurfaceBrush}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource DividerBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Ingredient" Binding="{Binding IngredientName}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Qty" Binding="{Binding QuantityPerBatch, StringFormat=N2}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitCode}" Width="70" IsReadOnly="True" />
                    <DataGridTextColumn Header="Price/Unit" Binding="{Binding PricePerUnit, Converter={StaticResource CurrencyConverter}}" Width="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="Price Unit" Binding="{Binding PriceUnitCode}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Cost" Binding="{Binding Cost, Converter={StaticResource CurrencyConverter}}" Width="110" IsReadOnly="True" />
                    <DataGridTextColumn Header="Cost + Waste" Binding="{Binding CostWithWaste, Converter={StaticResource CurrencyConverter}}" Width="130" IsReadOnly="True" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Error}" Width="140" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="4"
                Background="{DynamicResource MaterialDesignDividerBackground}"
                Padding="12,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           FontSize="12" />

                <mah:ProgressRing Grid.Column="1"
                                  IsActive="{Binding IsLoading}"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"
                                  Margin="8,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
