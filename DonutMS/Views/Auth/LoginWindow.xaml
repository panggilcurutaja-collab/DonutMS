<Window x:Class="DonutMS.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sign In"
        Height="480"
        Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        TextElement.Foreground="#1C1C1C"
        TextElement.FontSize="13"
        FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1E88E5"
                CornerRadius="6"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="Welcome Back"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="Login untuk mengakses Donut Management System."
                           Foreground="White"
                           Opacity="0.9"
                           FontSize="11"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Username"
                       FontSize="11"
                       Foreground="#546E7A" />
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8,6"
                     Background="#FFFFFF"
                     Margin="0,4,0,12" />

            <TextBlock Text="Password"
                       FontSize="11"
                       Foreground="#546E7A" />
            <Grid Margin="0,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox"
                             Grid.Column="0"
                             PasswordChanged="PasswordBox_OnPasswordChanged"
                             Padding="6"
                             Background="#FFFFFF"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanConverter}, ConverterParameter=Visibility}" />
                <TextBox Grid.Column="0"
                         Text="{Binding PasswordInput, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         Background="#FFFFFF"
                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ToggleButton Grid.Column="1"
                              IsChecked="{Binding IsPasswordVisible}"
                              Content="Show"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center" />
            </Grid>

            <CheckBox Content="Remember me"
                      IsChecked="{Binding RememberMe}"
                      Margin="0,6,0,0"
                      Foreground="#546E7A" />

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#D32F2F"
                       FontSize="11"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#2E7D32"
                       FontSize="11"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />

            <Button Content="Create New Account"
                    Command="{Binding OpenRegisterCommand}"
                    Background="Transparent"
                    Foreground="#1E88E5"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Exit"
                    Command="{Binding CancelCommand}"
                    Padding="12,6"
                    Background="#FFFFFF"
                    Foreground="#1C1C1C"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1" />
            <Button Content="Login"
                    Command="{Binding LoginCommand}"
                    Padding="12,6"
                    Margin="8,0,0,0"
                    Background="#1E88E5"
                    Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
