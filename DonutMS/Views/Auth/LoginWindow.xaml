<mah:MetroWindow x:Class="DonutMS.Views.Auth.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
                 Title="Sign In"
                 Height="560"
                 Width="520"
                 ResizeMode="NoResize"
                 ShowIconOnTitleBar="False"
                 WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource MaterialDesignPaper}" Margin="24">
        <Border Style="{StaticResource ModernCardStyle}"
                CornerRadius="14"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="14,14,0,0"
                        Padding="18,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FF1E3A8A" />
                            <GradientStop Offset="1" Color="#FF2563EB" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#33FFFFFF"
                                Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="AccountCircle" Width="20" Height="20" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Welcome Back"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Sign in to access Donut Management System"
                                       Foreground="#E5E7EB"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="20,18,20,14">
                    <TextBlock Text="Username"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.Watermark="Enter your username"
                             Margin="0,6,0,14" />

                    <TextBlock Text="Password"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Grid Margin="0,6,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="PasswordBox"
                                     Grid.Column="0"
                                     PasswordChanged="PasswordBox_OnPasswordChanged"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanConverter}, ConverterParameter=Visibility}" />
                        <TextBox Grid.Column="0"
                                 Text="{Binding PasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="Enter your password"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding IsPasswordVisible}"
                                      Content="Show"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <CheckBox Content="Remember me"
                              IsChecked="{Binding RememberMe}"
                              Margin="0,4,0,0" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="11"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource SuccessBrush}"
                               FontSize="11"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap" />

                    <Button Content="Create New Account"
                            Command="{Binding OpenRegisterCommand}"
                            Background="Transparent"
                            Foreground="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            Padding="2"
                            Margin="0,14,0,0" />
                </StackPanel>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Exit"
                                Command="{Binding CancelCommand}" />
                        <Button Content="Login"
                                Command="{Binding LoginCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>

