<mah:MetroWindow x:Class="DonutMS.Views.Auth.RegisterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
                 Title="Register User"
                 Height="700"
                 Width="560"
                 ResizeMode="NoResize"
                 ShowIconOnTitleBar="False"
                 WindowStartupLocation="CenterScreen">

    <Grid Background="{DynamicResource MaterialDesignPaper}" Margin="24">
        <Border Style="{StaticResource ModernCardStyle}"
                CornerRadius="14"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="14,14,0,0"
                        Padding="18,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FF0F766E" />
                            <GradientStop Offset="1" Color="#FF0EA5E9" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#30FFFFFF"
                                Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="AccountPlus" Width="20" Height="20" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Create User Account"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Set credentials and role access for the new user"
                                       Foreground="#E5E7EB"
                                       FontSize="12"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1"
                              Margin="20,16,20,10"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Username" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="Username"
                                 Margin="0,6,0,12" />

                        <TextBlock Text="Full Name" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="Full name"
                                 Margin="0,6,0,12" />

                        <TextBlock Text="Email" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.Watermark="name@company.com"
                                 Margin="0,6,0,12" />

                        <TextBlock Text="Role" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox ItemsSource="{Binding AvailableRoles}"
                                  SelectedItem="{Binding SelectedRole}"
                                  Margin="0,6,0,12" />

                        <TextBlock Text="Notes" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 Height="74"
                                 AcceptsReturn="True"
                                 mah:TextBoxHelper.Watermark="Optional notes"
                                 Margin="0,6,0,12" />

                        <TextBlock Text="Password" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid Margin="0,6,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PasswordBox"
                                         Grid.Column="0"
                                         PasswordChanged="PasswordBox_OnPasswordChanged"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanConverter}, ConverterParameter=Visibility}" />
                            <TextBox Grid.Column="0"
                                     Text="{Binding PasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                     mah:TextBoxHelper.Watermark="Set password"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding IsPasswordVisible}"
                                          Content="Show"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Confirm Password" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid Margin="0,6,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Grid.Column="0"
                                         PasswordChanged="ConfirmPasswordBox_OnPasswordChanged"
                                         Visibility="{Binding IsConfirmPasswordVisible, Converter={StaticResource InverseBooleanConverter}, ConverterParameter=Visibility}" />
                            <TextBox Grid.Column="0"
                                     Text="{Binding ConfirmPasswordInput, UpdateSourceTrigger=PropertyChanged}"
                                     mah:TextBoxHelper.Watermark="Re-enter password"
                                     Visibility="{Binding IsConfirmPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ToggleButton Grid.Column="1"
                                          IsChecked="{Binding IsConfirmPasswordVisible}"
                                          Content="Show"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="11"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   FontSize="11"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="20,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}" />
                        <Button Content="Register"
                                Command="{Binding RegisterCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</mah:MetroWindow>

