<Window x:Class="DonutMS.Views.Auth.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Register User"
        Height="620"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        TextElement.Foreground="#1C1C1C"
        TextElement.FontSize="13"
        FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#1E88E5"
                CornerRadius="6"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="Create New Account"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Text="Isi data pengguna untuk membuat akun baru."
                           Foreground="White"
                           Opacity="0.9"
                           FontSize="11"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,12">
            <StackPanel>
                <TextBlock Text="Username"
                           FontSize="11"
                           Foreground="#546E7A" />
                 <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         Background="#FFFFFF"
                         Margin="0,4,0,10" />

                <TextBlock Text="Full Name"
                           FontSize="11"
                           Foreground="#546E7A" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         Background="#FFFFFF"
                         Margin="0,4,0,10" />

                <TextBlock Text="Email"
                           FontSize="11"
                           Foreground="#546E7A" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         Background="#FFFFFF"
                         Margin="0,4,0,10" />

                <TextBlock Text="Role"
                           FontSize="11"
                           Foreground="#546E7A" />
                <ComboBox ItemsSource="{Binding AvailableRoles}"
                          SelectedItem="{Binding SelectedRole}"
                          Background="#FFFFFF"
                          Margin="0,4,0,10" />

                <TextBlock Text="Notes"
                           FontSize="11"
                           Foreground="#546E7A" />
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6"
                         Background="#FFFFFF"
                         TextWrapping="Wrap"
                         Height="60"
                         Margin="0,4,0,10" />

                <TextBlock Text="Password"
                           FontSize="11"
                           Foreground="#546E7A" />
                <Grid Margin="0,4,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordBox"
                                 Grid.Column="0"
                                 PasswordChanged="PasswordBox_OnPasswordChanged"
                                 Padding="6"
                                 Background="#FFFFFF"
                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanConverter}, ConverterParameter=Visibility}" />
                    <TextBox Grid.Column="0"
                             Text="{Binding PasswordInput, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"
                             Background="#FFFFFF"
                             Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding IsPasswordVisible}"
                                  Content="Show"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="Confirm Password"
                           FontSize="11"
                           Foreground="#546E7A" />
                <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Grid.Column="0"
                                 PasswordChanged="ConfirmPasswordBox_OnPasswordChanged"
                                 Padding="6"
                                 Background="#FFFFFF"
                                 Visibility="{Binding IsConfirmPasswordVisible, Converter={StaticResource InverseBooleanConverter}, ConverterParameter=Visibility}" />
                    <TextBox Grid.Column="0"
                             Text="{Binding ConfirmPasswordInput, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8,6"
                             Background="#FFFFFF"
                             Visibility="{Binding IsConfirmPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding IsConfirmPasswordVisible}"
                                  Content="Show"
                                  Margin="8,0,0,0"
                                  VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#D32F2F"
                           FontSize="11"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="#2E7D32"
                           FontSize="11"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Padding="12,6"
                    Background="#FFFFFF"
                    Foreground="#1C1C1C"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1" />
            <Button Content="Register"
                    Command="{Binding RegisterCommand}"
                    Padding="12,6"
                    Margin="8,0,0,0"
                    Background="#1E88E5"
                    Foreground="White" />
        </StackPanel>
    </Grid>
</Window>
