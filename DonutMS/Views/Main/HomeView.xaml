<UserControl x:Class="DonutMS.Views.Main.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Border Style="{StaticResource ModernCardStyle}"
                Padding="28"
                CornerRadius="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="620">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="68"
                        Height="68"
                        CornerRadius="34"
                        Background="{DynamicResource AccentLightBrush}"
                        VerticalAlignment="Top"
                        Margin="0,2,18,0">
                    <iconPacks:PackIconMaterial Kind="Home"
                                                Width="34"
                                                Height="34"
                                                Foreground="{DynamicResource AccentBrush}"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding WelcomeTitle}"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding WelcomeSubtitle}"
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <Border Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="10"
                            Margin="0,18,0,0"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="LightbulbOnOutline"
                                                        Width="16"
                                                        Height="16"
                                                        Foreground="{DynamicResource WarningBrush}"
                                                        Margin="0,1,8,0" />
                            <TextBlock Text="Tip: open Dashboard when needed to keep startup snappy."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

