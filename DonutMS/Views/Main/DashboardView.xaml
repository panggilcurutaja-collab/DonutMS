<UserControl x:Class="DonutMS.Views.Main.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="20,16"
                BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                BorderThickness="0,0,0,2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0" Color="#FF1E3A8A" />
                    <GradientStop Offset="1" Color="#FF2563EB" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="44"
                            Height="44"
                            CornerRadius="22"
                            Background="#35FFFFFF"
                            Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="ViewDashboard"
                                                    Width="22"
                                                    Height="22"
                                                    Foreground="White"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Dashboard"
                                   Foreground="White"  Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Ringkasan KPI, tren biaya, dan performa SKU"
                                   Foreground="White"
                                   Opacity="0.9"
                                   FontSize="12"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshDataCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh" Foreground="White" />
                        </StackPanel>
                    </Button>
                    <mah:ProgressRing Width="18"
                                      Height="18"
                                      IsActive="{Binding IsLoading}"
                                      Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel Orientation="Vertical">
                <!-- KPI Cards -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <Border Style="{StaticResource ModernCardStyle}"
                            Padding="14"
                            Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Average HPP"  Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding AverageHPP, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBlock Text="Last 30 days"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}"
                            Padding="14"
                            Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Gross Margin"  Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding GrossMarginPercent, StringFormat={}{0:N1}%}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBlock Text="Avg per SKU"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}"
                            Padding="14"
                            Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock Text="Total Material Cost"  Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding TotalMaterialCost, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBlock Text="Last 30 days"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Cost per Donut"  Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding CostPerUnit, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBlock Text="HPP/unit"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}"
                            Padding="14"
                            Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Avg Profit / SKU"  Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding AverageProfitPerSku, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBlock Text="Per unit"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}"
                            Padding="14"
                            Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Low Stock Items"  Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding LowStockCount}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBlock Text="Needs reorder"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}"
                            Padding="14"
                            Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Active Batches"  Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding ActiveBatchCount}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBlock Text="In progress"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       FontSize="10" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModernCardStyle}"
                            Padding="14"
                            Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Waste %"  Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding WastePercent, StringFormat={}{0:N1}%}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <TextBlock Text="Last 30 days"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       FontSize="10" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <!-- Trends -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource ModernCardStyle}"
                            Padding="16"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Weekly Material Cost Trend"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <ItemsControl ItemsSource="{Binding WeeklyTrend}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}"  Style="{StaticResource FieldLabelStyle}" />
                                            <ProgressBar Grid.Column="1"
                                                         Height="6"
                                                         Margin="8,6,8,0"
                                                         Maximum="100"
                                                         Value="{Binding PercentOfMax}"
                                                         Background="{DynamicResource MaterialDesignDividerBackground}"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Value, Converter={StaticResource CurrencyConverter}}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource ModernCardStyle}"
                            Padding="16"
                            Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Monthly Material Cost Trend"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <ItemsControl ItemsSource="{Binding MonthlyTrend}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}"  Style="{StaticResource FieldLabelStyle}" />
                                            <ProgressBar Grid.Column="1"
                                                         Height="6"
                                                         Margin="8,6,8,0"
                                                         Maximum="100"
                                                         Value="{Binding PercentOfMax}"
                                                         Background="{DynamicResource MaterialDesignDividerBackground}"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Value, Converter={StaticResource CurrencyConverter}}"
                                                       FontSize="11"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- SKU Performance -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource ModernCardStyle}"
                            Padding="16"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Top SKU Performance"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <DataGrid ItemsSource="{Binding TopSkuPerformance}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      Margin="0,10,0,0"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource DividerBrush}"
                                      RowBackground="{DynamicResource MaterialDesignPaper}"
                                      AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                    </Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Code}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" IsReadOnly="True" />
                                    <DataGridTextColumn Header="HPP" Binding="{Binding HPP, Converter={StaticResource CurrencyConverter}}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Profit" Binding="{Binding ProfitPerUnit, Converter={StaticResource CurrencyConverter}}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Margin" Binding="{Binding GrossMarginPercent, StringFormat={}{0:N1}%}" Width="80" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource ModernCardStyle}"
                            Padding="16"
                            Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Bottom SKU Performance"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <DataGrid ItemsSource="{Binding BottomSkuPerformance}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      Margin="0,10,0,0"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource DividerBrush}"
                                      RowBackground="{DynamicResource MaterialDesignPaper}"
                                      AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                    </Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Code}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" IsReadOnly="True" />
                                    <DataGridTextColumn Header="HPP" Binding="{Binding HPP, Converter={StaticResource CurrencyConverter}}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Profit" Binding="{Binding ProfitPerUnit, Converter={StaticResource CurrencyConverter}}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Margin" Binding="{Binding GrossMarginPercent, StringFormat={}{0:N1}%}" Width="80" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- Production & Inventory -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource ModernCardStyle}"
                            Padding="16"
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Production Metrics"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Target Yield"  Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding TargetYield, StringFormat=N0}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Actual Yield"  Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding ActualYield, StringFormat=N0}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Yield %"  Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding YieldPercent, StringFormat={}{0:N1}%}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Yield Achievement"
                                       Margin="0,12,0,4"  Style="{StaticResource FieldLabelStyle}" />
                            <ProgressBar Height="8"
                                         Maximum="100"
                                         Value="{Binding YieldPercent}"
                                         Background="{DynamicResource MaterialDesignDividerBackground}"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />

                            <TextBlock Text="{Binding WastePercent, StringFormat=Waste {0:N1}%}"
                                       Margin="0,10,0,0"  Style="{StaticResource FieldLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource ModernCardStyle}"
                            Padding="16"
                            Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Low Stock Inventory"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource MaterialDesignBody}" />
                            <DataGrid ItemsSource="{Binding LowStockItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      Margin="0,10,0,0"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource DividerBrush}"
                                      RowBackground="{DynamicResource MaterialDesignPaper}"
                                      AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                    </Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ingredient" Binding="{Binding IngredientName}" Width="160" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Available" Binding="{Binding AvailableQuantity, StringFormat=N2}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitCode}" Width="60" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Min" Binding="{Binding MinimumStockLevel, StringFormat=N2}" Width="70" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Reorder" Binding="{Binding ReorderPoint, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource MaterialDesignDividerBackground}"
                Padding="12,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerBrush}">
            <TextBlock Text="{Binding ErrorMessage}"  Style="{StaticResource FieldLabelStyle}" />
        </Border>
    </Grid>
</UserControl>



