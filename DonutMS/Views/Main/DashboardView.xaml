<UserControl x:Class="DonutMS.Views.Main.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/materialdesign"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Section -->
        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryHueMidBrush}"
                Padding="20,16"
                BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                BorderThickness="0,0,0,2">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Dashboard"
                          Foreground="White"
                          FontSize="28"
                          FontWeight="SemiBold" />
                <TextBlock Text="Welcome to DonutMS - Donut Management System"
                          Foreground="{DynamicResource MaterialDesignPaper}"
                          FontSize="14"
                          Opacity="0.9"
                          Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Dashboard Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel Orientation="Vertical">
                <!-- Welcome Message -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                       Padding="20"
                       CornerRadius="4"
                       BorderBrush="{DynamicResource DividerBrush}"
                       BorderThickness="1"
                       Margin="0,0,0,16">
                    <StackPanel Orientation="Vertical" Margin="0,0,0,0">
                        <TextBlock Text="Getting Started"
                                  FontSize="18"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBlock Text="This is the DonutMS Dashboard. Navigate using the menu on the left to access different modules:"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  TextWrapping="Wrap"
                                  Margin="0,12,0,0" />
                        <StackPanel Orientation="Vertical" Margin="0,12,0,0">
                            <TextBlock Text="?? Ingredients - Manage ingredient inventory and suppliers"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      Margin="0,4,0,0" />
                            <TextBlock Text="?? Recipes - Create and manage donut recipes"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      Margin="0,4,0,0" />
                            <TextBlock Text="?? Inventory - Track stock levels and movements"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      Margin="0,4,0,0" />
                            <TextBlock Text="?? Production - Manage production batches and jobs"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      Margin="0,4,0,0" />
                            <TextBlock Text="?? Pricing - Calculate costs and margins"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stats Cards Grid -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Total Ingredients -->
                    <Border Grid.Column="0"
                           Background="{DynamicResource MaterialDesignCardBackground}"
                           Padding="16"
                           CornerRadius="4"
                           Margin="0,0,8,0"
                           BorderBrush="{DynamicResource DividerBrush}"
                           BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Total Ingredients"
                                      FontSize="12"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBlock Text="--"
                                      FontSize="32"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}"
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Active Recipes -->
                    <Border Grid.Column="1"
                           Background="{DynamicResource MaterialDesignCardBackground}"
                           Padding="16"
                           CornerRadius="4"
                           Margin="8,0,8,0"
                           BorderBrush="{DynamicResource DividerBrush}"
                           BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Active Recipes"
                                      FontSize="12"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBlock Text="--"
                                      FontSize="32"
                                      FontWeight="Bold"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}"
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Low Stock Items -->
                    <Border Grid.Column="2"
                           Background="{DynamicResource MaterialDesignCardBackground}"
                           Padding="16"
                           CornerRadius="4"
                           Margin="8,0,0,0"
                           BorderBrush="{DynamicResource DividerBrush}"
                           BorderThickness="1">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Low Stock Items"
                                      FontSize="12"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}" />
                            <TextBlock Text="--"
                                      FontSize="32"
                                      FontWeight="Bold"
                                      Foreground="#FF2196F3"
                                      Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Info Section -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                       Padding="20"
                       CornerRadius="4"
                       BorderBrush="{DynamicResource DividerBrush}"
                       BorderThickness="1">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="System Information"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBlock Text="Version: 1.0.0 (Phase 7)"
                                  Foreground="{DynamicResource MaterialDesignBodyLight}"
                                  FontSize="12"
                                  Margin="0,8,0,0" />
                        <TextBlock Text="Status: Development"
                                  Foreground="{DynamicResource MaterialDesignBodyLight}"
                                  FontSize="12"
                                  Margin="0,4,0,0" />
                        <TextBlock Text="All modules are being implemented in phases. Check back soon for updates!"
                                  Foreground="{DynamicResource MaterialDesignBodyLight}"
                                  FontSize="12"
                                  Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
