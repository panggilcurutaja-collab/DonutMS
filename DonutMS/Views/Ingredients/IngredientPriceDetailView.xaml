<UserControl x:Class="DonutMS.Views.Ingredients.IngredientPriceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="700">

    <Grid Background="{DynamicResource MaterialDesignPaper}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding DialogTitle}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource MaterialDesignBody}"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,12">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Ingredient" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <ComboBox ItemsSource="{Binding Ingredients}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding EditingPrice.IngredientId}"
                                  DisplayMemberPath="Name"
                                  Background="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Supplier" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <ComboBox ItemsSource="{Binding Suppliers}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding EditingPrice.SupplierId}"
                                  DisplayMemberPath="Name"
                                  Background="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Price" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox Text="{Binding EditingPrice.Price, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource DividerBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Unit" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <ComboBox ItemsSource="{Binding AvailableUnits}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding EditingPrice.UnitId}"
                                  DisplayMemberPath="Code"
                                  Background="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Effective Date" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <DatePicker SelectedDate="{Binding EditingPrice.EffectiveDate}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="End Date" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <DatePicker SelectedDate="{Binding EditingPrice.EndDate}"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Minimum Quantity" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox Text="{Binding EditingPrice.MinimumQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource DividerBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Notes" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox Text="{Binding EditingPrice.Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource DividerBrush}" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="Active" IsChecked="{Binding EditingPrice.IsActive}" Foreground="{DynamicResource MaterialDesignBody}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Command="{Binding SavePriceCommand}"
                    Content="Save"
                    Padding="24,8"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    Foreground="White"
                    BorderThickness="0"
                    Margin="0,0,8,0" />
            <Button Command="{Binding CancelDialogCommand}"
                    Content="Cancel"
                    Padding="24,8"
                    Background="{DynamicResource MaterialDesignBodyLight}"
                    Foreground="White"
                    BorderThickness="0" />
        </StackPanel>
    </Grid>
</UserControl>
