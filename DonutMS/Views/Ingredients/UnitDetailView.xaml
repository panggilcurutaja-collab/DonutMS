<UserControl x:Class="DonutMS.Views.Ingredients.UnitDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="600">

    <Grid Background="{DynamicResource MaterialDesignPaper}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding DialogTitle}"
                   Margin="0,0,0,16"  Style="{StaticResource DialogTitleStyle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,12">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Unit Code *" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBox Text="{Binding EditingUnit.Code, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,8"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource DividerBrush}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Unit Name *" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBox Text="{Binding EditingUnit.Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,8"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource DividerBrush}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Category *" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    <ComboBox ItemsSource="{Binding UnitCategories}"
                              SelectedItem="{Binding EditingUnit.Category}"
                              Background="{DynamicResource SurfaceBrush}"
                              Foreground="{DynamicResource MaterialDesignBody}" />
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Conversion Factor" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox Text="{Binding EditingUnit.ConversionFactor, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource DividerBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Base Unit" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox Text="{Binding EditingUnit.BaseUnit, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource DividerBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Description" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBox Text="{Binding EditingUnit.Description, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,8"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource DividerBrush}"
                             AcceptsReturn="True"
                             Height="80"
                             TextWrapping="Wrap" />
                </StackPanel>

                <CheckBox Content="Active" IsChecked="{Binding EditingUnit.IsActive}" Foreground="{DynamicResource MaterialDesignBody}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Command="{Binding SaveUnitCommand}"
                    Content="Save"
                    Padding="24,8"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Command="{Binding CancelDialogCommand}"
                    Content="Cancel"
                    Padding="24,8"
                    Background="{DynamicResource MaterialDesignBodyLight}"
                    Foreground="White"
                    BorderThickness="0" />
        </StackPanel>
    </Grid>
</UserControl>



