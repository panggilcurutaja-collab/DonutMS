<UserControl x:Class="DonutMS.Views.Ingredients.IngredientListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:DonutMS.Views.Ingredients"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Ingredient Management"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource MaterialDesignBody}"
                   Margin="0,0,0,16" />

        <!-- Search & Filter Controls -->
        <Border Grid.Row="1"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="16"
                CornerRadius="4"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search TextBox -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,8"
                         Background="White"
                         Foreground="{DynamicResource MaterialDesignBody}"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource DividerBrush}"
                         Margin="0,0,12,0" />

                <!-- Search Button -->
                <Button Grid.Column="1"
                        Command="{Binding SearchIngredientsCommand}"
                        Content="Search"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Background="{DynamicResource PrimaryHueMidBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" />

                <!-- Add Button -->
                <Button Grid.Column="2"
                        Command="{Binding OpenAddDialogCommand}"
                        Content="+ Add Ingredient"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Background="Green"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" />

                <!-- Show Inactive Checkbox -->
                <CheckBox Grid.Column="3"
                          Content="Show Inactive"
                          IsChecked="{Binding ShowInactiveOnly}"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource MaterialDesignBody}" />
            </Grid>
        </Border>

        <!-- DataGrid with Ingredients -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Ingredients}"
                  SelectedItem="{Binding SelectedIngredient}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Background="White"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource DividerBrush}"
                  RowBackground="{DynamicResource MaterialDesignPaper}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU"
                                   Binding="{Binding SKU}"
                                   Width="100"
                                   IsReadOnly="True" />
                <DataGridTextColumn Header="Name"
                                   Binding="{Binding Name}"
                                   Width="200"
                                   IsReadOnly="True" />
                <DataGridTextColumn Header="Description"
                                   Binding="{Binding Description}"
                                   Width="*"
                                   IsReadOnly="True" />
                <DataGridTextColumn Header="Reorder Point"
                                   Binding="{Binding ReorderPoint, StringFormat=N2}"
                                   Width="100"
                                   IsReadOnly="True" />
                <DataGridTextColumn Header="Min Stock"
                                   Binding="{Binding MinimumStockLevel, StringFormat=N2}"
                                   Width="100"
                                   IsReadOnly="True" />
                <DataGridCheckBoxColumn Header="Active"
                                       Binding="{Binding IsActive}"
                                       Width="60"
                                       IsReadOnly="True" />
                <DataGridTemplateColumn Header="Actions" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding .}"
                                        Content="Edit"
                                        Padding="8,4"
                                        FontSize="11"
                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Margin="0,0,4,0" />
                                <Button Command="{Binding DataContext.DeleteIngredientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding .}"
                                        Content="Delete"
                                        Padding="8,4"
                                        FontSize="11"
                                        Background="Red"
                                        Foreground="White"
                                        BorderThickness="0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource MaterialDesignDividerBackground}"
                Padding="16,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerBrush}"
                Margin="0,16,0,0">
            <TextBlock Text="{Binding Ingredients.Count, StringFormat='Total Ingredients: {0}'}"
                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                      FontSize="12" />
        </Border>
    </Grid>
</UserControl>
