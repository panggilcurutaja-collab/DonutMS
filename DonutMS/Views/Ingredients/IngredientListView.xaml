
<UserControl x:Class="DonutMS.Views.Ingredients.IngredientListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:child="clr-namespace:MahApps.Metro.SimpleChildWindow;assembly=MahApps.Metro.SimpleChildWindow"
             xmlns:views="clr-namespace:DonutMS.Views.Ingredients"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <child:ChildWindow IsOpen="{Binding IsDialogOpen}" OverlayBrush="#88000000">
            <child:ChildWindow.Content>
                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                        Padding="16"
                        CornerRadius="6"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        Width="720"
                        MaxHeight="680">
                    <ContentControl>
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:IngredientDetailView />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DialogMode}" Value="Unit">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <views:UnitDetailView />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DialogMode}" Value="Supplier">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <views:SupplierDetailView />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DialogMode}" Value="Price">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <views:IngredientPriceDetailView />
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Border>
            </child:ChildWindow.Content>
        </child:ChildWindow>

        <Grid>
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- Ingredients Tab -->
                <TabItem Header="Ingredients">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Ingredient Management"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   Margin="0,0,0,16" />

                        <Border Grid.Row="1"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                Padding="16"
                                CornerRadius="4"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,8"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource MaterialDesignBody}"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource DividerBrush}"
                                         Margin="0,0,12,0" />

                                <Button Grid.Column="1"
                                        Command="{Binding SearchIngredientsCommand}"
                                        Content="Search"
                                        Padding="16,8"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand" />

                                <Button Grid.Column="2"
                                        Command="{Binding OpenAddDialogCommand}"
                                        Content="+ Add Ingredient"
                                        Padding="16,8"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource SuccessBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand" />

                                <CheckBox Grid.Column="3"
                                          Content="Show Inactive"
                                          IsChecked="{Binding ShowInactiveOnly}"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Ingredients}"
                                  SelectedItem="{Binding SelectedIngredient}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="{DynamicResource SurfaceBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource DividerBrush}"
                                  RowBackground="{DynamicResource MaterialDesignPaper}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="SKU"
                                                   Binding="{Binding SKU}"
                                                   Width="100"
                                                   IsReadOnly="True" />
                                <DataGridTextColumn Header="Name"
                                                   Binding="{Binding Name}"
                                                   Width="200"
                                                   IsReadOnly="True" />
                                <DataGridTextColumn Header="Description"
                                                   Binding="{Binding Description}"
                                                   Width="*"
                                                   IsReadOnly="True" />
                                <DataGridTextColumn Header="Reorder Point"
                                                   Binding="{Binding ReorderPoint, StringFormat=N2}"
                                                   Width="100"
                                                   IsReadOnly="True" />
                                <DataGridTextColumn Header="Min Stock"
                                                   Binding="{Binding MinimumStockLevel, StringFormat=N2}"
                                                   Width="100"
                                                   IsReadOnly="True" />
                                <DataGridCheckBoxColumn Header="Active"
                                                       Binding="{Binding IsActive}"
                                                       Width="60"
                                                       IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4">
                                                <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="Edit"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="0,0,4,0" />
                                                <Button Command="{Binding DataContext.DeleteIngredientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="Delete"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Background="{DynamicResource DangerBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="3"
                                Background="{DynamicResource MaterialDesignDividerBackground}"
                                Padding="16,8"
                                BorderThickness="0,1,0,0"
                                BorderBrush="{DynamicResource DividerBrush}"
                                Margin="0,16,0,0">
                            <TextBlock Text="{Binding Ingredients.Count, StringFormat='Total Ingredients: {0}'}"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                                      FontSize="12" />
                        </Border>
                    </Grid>
                </TabItem>
                <!-- Units Tab -->
                <TabItem Header="Units">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Unit Setup"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   Margin="0,0,0,16" />

                        <Border Grid.Row="1"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                Padding="16"
                                CornerRadius="4"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding UnitSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,8"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource MaterialDesignBody}"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource DividerBrush}"
                                         Margin="0,0,12,0" />

                                <Button Grid.Column="1"
                                        Command="{Binding SearchUnitsCommand}"
                                        Content="Search"
                                        Padding="16,8"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand" />

                                <Button Grid.Column="2"
                                        Command="{Binding OpenAddUnitDialogCommand}"
                                        Content="+ Add Unit"
                                        Padding="16,8"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource SuccessBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand" />

                                <CheckBox Grid.Column="3"
                                          Content="Show Inactive"
                                          IsChecked="{Binding ShowInactiveUnits}"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Units}"
                                  SelectedItem="{Binding SelectedUnit}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="{DynamicResource SurfaceBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource DividerBrush}"
                                  RowBackground="{DynamicResource MaterialDesignPaper}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" IsReadOnly="True" />
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="Factor" Binding="{Binding ConversionFactor, StringFormat=N4}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Base Unit" Binding="{Binding BaseUnit}" Width="100" IsReadOnly="True" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4">
                                                <Button Command="{Binding DataContext.OpenEditUnitDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="Edit"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="0,0,4,0" />
                                                <Button Command="{Binding DataContext.DeleteUnitCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="Delete"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Background="{DynamicResource DangerBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <!-- Suppliers Tab -->
                <TabItem Header="Suppliers">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Supplier Management"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   Margin="0,0,0,16" />

                        <Border Grid.Row="1"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                Padding="16"
                                CornerRadius="4"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,8"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource MaterialDesignBody}"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource DividerBrush}"
                                         Margin="0,0,12,0" />

                                <Button Grid.Column="1"
                                        Command="{Binding SearchSuppliersCommand}"
                                        Content="Search"
                                        Padding="16,8"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand" />

                                <Button Grid.Column="2"
                                        Command="{Binding OpenAddSupplierDialogCommand}"
                                        Content="+ Add Supplier"
                                        Padding="16,8"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource SuccessBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand" />

                                <CheckBox Grid.Column="3"
                                          Content="Show Inactive"
                                          IsChecked="{Binding ShowInactiveSuppliers}"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="{DynamicResource SurfaceBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource DividerBrush}"
                                  RowBackground="{DynamicResource MaterialDesignPaper}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" IsReadOnly="True" />
                                <DataGridTextColumn Header="Contact" Binding="{Binding ContactPerson}" Width="160" IsReadOnly="True" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" IsReadOnly="True" />
                                <DataGridTextColumn Header="Lead Time (Days)" Binding="{Binding LeadTimeDays}" Width="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="Min Order" Binding="{Binding MinimumOrderQuantity, StringFormat=N2}" Width="100" IsReadOnly="True" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4">
                                                <Button Command="{Binding DataContext.OpenEditSupplierDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="Edit"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="0,0,4,0" />
                                                <Button Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="Delete"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Background="{DynamicResource DangerBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
                <!-- Prices Tab -->
                <TabItem Header="Ingredient Prices">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Supplier Mapping &amp; Prices"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}"
                                   Margin="0,0,0,16" />

                        <Border Grid.Row="1"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                Padding="16"
                                CornerRadius="4"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding Ingredients}"
                                          SelectedItem="{Binding SelectedIngredient}"
                                          DisplayMemberPath="Name"
                                          Background="{DynamicResource SurfaceBrush}"
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                          Margin="0,0,12,0" />

                                <TextBox Grid.Column="1"
                                         Text="{Binding PriceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="12,8"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource MaterialDesignBody}"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource DividerBrush}"
                                         Margin="0,0,12,0" />

                                <Button Grid.Column="2"
                                        Command="{Binding SearchPricesCommand}"
                                        Content="Search"
                                        Padding="16,8"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand" />

                                <Button Grid.Column="3"
                                        Command="{Binding OpenAddPriceDialogCommand}"
                                        Content="+ Add Price"
                                        Padding="16,8"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource SuccessBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand" />

                                <CheckBox Grid.Column="4"
                                          Content="Show Inactive"
                                          IsChecked="{Binding ShowInactivePrices}"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding IngredientPrices}"
                                  SelectedItem="{Binding SelectedPrice}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  Background="{DynamicResource SurfaceBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource DividerBrush}"
                                  RowBackground="{DynamicResource MaterialDesignPaper}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="200" IsReadOnly="True" />
                                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Unit" Binding="{Binding UnitCode}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="Min Qty" Binding="{Binding MinimumQuantity, StringFormat=N2}" Width="90" IsReadOnly="True" />
                                <DataGridTextColumn Header="Effective" Binding="{Binding EffectiveDate, StringFormat=d}" Width="110" IsReadOnly="True" />
                                <DataGridTextColumn Header="End" Binding="{Binding EndDate, StringFormat=d}" Width="110" IsReadOnly="True" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Actions" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4">
                                                <Button Command="{Binding DataContext.OpenEditPriceDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="Edit"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        Margin="0,0,4,0" />
                                                <Button Command="{Binding DataContext.DeletePriceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding .}"
                                                        Content="Delete"
                                                        Padding="8,4"
                                                        FontSize="11"
                                                        Background="{DynamicResource DangerBrush}"
                                                        Foreground="White"
                                                        BorderThickness="0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
