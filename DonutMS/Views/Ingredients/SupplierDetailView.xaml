<UserControl x:Class="DonutMS.Views.Ingredients.SupplierDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="700">

    <Grid Background="{DynamicResource MaterialDesignPaper}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding DialogTitle}"
                   Margin="0,0,0,16"  Style="{StaticResource DialogTitleStyle}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,12">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Supplier Name *" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBox Text="{Binding EditingSupplier.Name, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,8"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource DividerBrush}" />
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Contact Person" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox Text="{Binding EditingSupplier.ContactPerson, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource DividerBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Phone" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox Text="{Binding EditingSupplier.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource DividerBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Email" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBox Text="{Binding EditingSupplier.Email, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,8"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource DividerBrush}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Address" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    <TextBox Text="{Binding EditingSupplier.Address, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,8"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource DividerBrush}"
                             AcceptsReturn="True"
                             Height="80"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Lead Time (Days)" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox Text="{Binding EditingSupplier.LeadTimeDays, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource DividerBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="Min Order Qty" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox Text="{Binding EditingSupplier.MinimumOrderQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource DividerBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="8,0,0,0">
                        <TextBlock Text="Payment Terms" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                        <TextBox Text="{Binding EditingSupplier.PaymentTerms, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12,8"
                                 Background="{DynamicResource SurfaceBrush}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 BorderThickness="1"
                                 BorderBrush="{DynamicResource DividerBrush}" />
                    </StackPanel>
                </Grid>

                <CheckBox Content="Active" IsChecked="{Binding EditingSupplier.IsActive}" Foreground="{DynamicResource MaterialDesignBody}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Command="{Binding SaveSupplierCommand}"
                    Content="Save"
                    Padding="24,8"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0" />
            <Button Command="{Binding CancelDialogCommand}"
                    Content="Cancel"
                    Padding="24,8"
                    Background="{DynamicResource MaterialDesignBodyLight}"
                    Foreground="White"
                    BorderThickness="0" />
        </StackPanel>
    </Grid>
</UserControl>



