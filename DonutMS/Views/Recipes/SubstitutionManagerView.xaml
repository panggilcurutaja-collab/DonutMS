<UserControl x:Class="DonutMS.Views.Recipes.SubstitutionManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryHueMidBrush}"
                Padding="20,16"
                BorderBrush="{DynamicResource PrimaryHueLightBrush}"
                BorderThickness="0,0,0,2">
            <StackPanel>
                <TextBlock Text="Substitution Manager"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold" />
                <TextBlock Text="Setup alternative ingredients and analyze cost impact"
                           Foreground="White"
                           Opacity="0.9"
                           FontSize="12"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Rule Setup -->
        <Border Grid.Row="1"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="16"
                Margin="16,16,16,8"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Original Ingredient"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Substitute Ingredient"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Ratio"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="12,0,0,0" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Cost Impact"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="12,0,0,0" />

                <ComboBox Grid.Row="1" Grid.Column="0"
                          ItemsSource="{Binding Ingredients}"
                          SelectedItem="{Binding SelectedOriginalIngredient}"
                          DisplayMemberPath="Name"
                          Margin="0,6,12,0"
                          Background="White"
                          Foreground="{DynamicResource MaterialDesignBody}"
                          Padding="10,6" />

                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding Ingredients}"
                          SelectedItem="{Binding SelectedSubstituteIngredient}"
                          DisplayMemberPath="Name"
                          Margin="0,6,12,0"
                          Background="White"
                          Foreground="{DynamicResource MaterialDesignBody}"
                          Padding="10,6" />

                <TextBox Grid.Row="1" Grid.Column="2"
                         Text="{Binding SubstitutionRatio, UpdateSourceTrigger=PropertyChanged}"
                         Width="90"
                         Margin="12,6,12,0"
                         Background="White"
                         Foreground="{DynamicResource MaterialDesignBody}"
                         Padding="10,6" />

                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Vertical" Margin="12,6,0,0">
                    <TextBlock Text="{Binding CostImpact, Converter={StaticResource CurrencyConverter}}"
                               Foreground="{DynamicResource MaterialDesignBody}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CostImpactPercent, StringFormat={}{0:N1}%}"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,8">
            <Button Command="{Binding CreateSubstitutionCommand}"
                    Content="Save Rule"
                    Padding="16,8"
                    Background="Green"
                    Foreground="White"
                    BorderThickness="0" />
        </StackPanel>

        <!-- Substitution List -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Substitutions}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Margin="16,0,16,16"
                  Background="White"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource DividerBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Original"
                                   Binding="{Binding OriginalIngredientName}"
                                   Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Substitute"
                                   Binding="{Binding SubstituteIngredientName}"
                                   Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Ratio"
                                   Binding="{Binding SubstitutionRatio, StringFormat=N2}"
                                   Width="80" IsReadOnly="True" />
                <DataGridTextColumn Header="Cost Impact"
                                   Binding="{Binding CostImpact, Converter={StaticResource CurrencyConverter}}"
                                   Width="120" IsReadOnly="True" />
                <DataGridCheckBoxColumn Header="Approved"
                                       Binding="{Binding IsApproved}"
                                       Width="80" IsReadOnly="True" />
                <DataGridTemplateColumn Header="Action" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ApproveSubstitutionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding .}"
                                    Content="Approve"
                                    Padding="8,4"
                                    FontSize="11"
                                    Background="{DynamicResource PrimaryHueMidBrush}"
                                    Foreground="White"
                                    BorderThickness="0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource MaterialDesignDividerBackground}"
                Padding="12,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           FontSize="12" />

                <mah:ProgressRing Grid.Column="1"
                                  IsActive="{Binding IsLoading}"
                                  Foreground="{DynamicResource PrimaryHueMidBrush}"
                                  Margin="8,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
