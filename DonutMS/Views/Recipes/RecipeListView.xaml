<UserControl x:Class="DonutMS.Views.Recipes.RecipeListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:child="clr-namespace:MahApps.Metro.SimpleChildWindow;assembly=MahApps.Metro.SimpleChildWindow"
             xmlns:views="clr-namespace:DonutMS.Views.Recipes"
             xmlns:local="clr-namespace:DonutMS.Views.Recipes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <child:ChildWindow IsOpen="{Binding IsEditorOpen}" OverlayBrush="#88000000">
            <child:ChildWindow.Content>
                <views:RecipeEditorView DataContext="{Binding}" />
            </child:ChildWindow.Content>
        </child:ChildWindow>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Recipe Management"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource MaterialDesignBody}"
                   Margin="0,0,0,16" />

        <!-- Search & Filter Controls -->
        <Border Grid.Row="1"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="16"
                CornerRadius="4"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search TextBox -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12,8"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource MaterialDesignBody}"
                         BorderThickness="1"
                         BorderBrush="{DynamicResource DividerBrush}"
                         Margin="0,0,12,0"
                         mah:TextBoxHelper.Watermark="Search recipes by name or code..." />

                <!-- Search Button -->
                <Button Grid.Column="1"
                        Command="{Binding LoadRecipesCommand}"
                        Content="Search"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Background="{DynamicResource PrimaryHueMidBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" />

                <!-- Add Button -->
                <Button Grid.Column="2"
                        Command="{Binding OpenCreateRecipeCommand}"
                        Content="+ New Recipe"
                        Padding="16,8"
                        Margin="0,0,8,0"
                        Background="{DynamicResource SuccessBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand" />

                <!-- Show Inactive Checkbox -->
                <CheckBox Grid.Column="3"
                          Content="Show Inactive"
                          IsChecked="{Binding ShowInactiveOnly}"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource MaterialDesignBody}" />
            </Grid>
        </Border>

        <!-- DataGrid with Recipes -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Recipes}"
                  SelectedItem="{Binding SelectedRecipe}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Background="{DynamicResource SurfaceBrush}"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource DividerBrush}"
                  RowBackground="{DynamicResource MaterialDesignPaper}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Code"
                                   Binding="{Binding Code}"
                                   Width="100"
                                   IsReadOnly="True" />
                <DataGridTextColumn Header="Name"
                                   Binding="{Binding Name}"
                                   Width="200"
                                   IsReadOnly="True" />
                <DataGridTextColumn Header="Description"
                                   Binding="{Binding Description}"
                                   Width="250"
                                   IsReadOnly="True" />
                <DataGridTextColumn Header="Yield"
                                   Binding="{Binding YieldPerBatch, StringFormat=N2}"
                                   Width="80"
                                   IsReadOnly="True" />
                <DataGridTextColumn Header="Unit"
                                   Binding="{Binding YieldUnitCode}"
                                   Width="70"
                                   IsReadOnly="True" />
                <DataGridTextColumn Header="Prod. Time (min)"
                                   Binding="{Binding EstimatedProductionTime, StringFormat=N0}"
                                   Width="120"
                                   IsReadOnly="True" />
                <DataGridCheckBoxColumn Header="Active"
                                       Binding="{Binding IsActive}"
                                       Width="60"
                                       IsReadOnly="True" />
                <DataGridTemplateColumn Header="Actions" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4">
                                <Button Command="{Binding DataContext.SelectRecipeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding .}"
                                        Content="Edit"
                                        Padding="8,4"
                                        FontSize="11"
                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Margin="0,0,4,0" />
                                <Button Command="{Binding DataContext.CreateVersionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding .}"
                                        Content="Version"
                                        Padding="8,4"
                                        FontSize="11"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Margin="0,0,4,0" />
                                <Button Command="{Binding DataContext.DeleteRecipeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding .}"
                                        Content="Delete"
                                        Padding="8,4"
                                        FontSize="11"
                                        Background="{DynamicResource DangerBrush}"
                                        Foreground="White"
                                        BorderThickness="0" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource MaterialDesignDividerBackground}"
                Padding="16,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status Info -->
                <TextBlock Grid.Column="0"
                          Text="{Binding StatusMessage}"
                          Foreground="{DynamicResource MaterialDesignBodyLight}"
                          FontSize="12" />

                <!-- Loading Indicator -->
                <mah:ProgressRing Grid.Column="1"
                                 IsActive="{Binding IsLoading}"
                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                 Margin="8,0,0,0" />
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
