<UserControl x:Class="DonutMS.Views.Recipes.RecipeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:DonutMS.Views.Recipes"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource MaterialDesignCardBackground}"
                Padding="16"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="{Binding CurrentRecipe, StringFormat='Edit Recipe: {0.Name}', FallbackValue='Create New Recipe'}"
                          FontSize="18"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource MaterialDesignBody}" />
            </StackPanel>
        </Border>

        <!-- Main Content with Tab-like Sections -->
        <TabControl Grid.Row="1"
                   Margin="16"
                   Background="Transparent"
                   BorderBrush="{DynamicResource DividerBrush}">

            <!-- Tab 1: Recipe Details -->
            <TabItem Header="Recipe Details" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Recipe Code -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                  Text="Recipe Code:"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,12" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                Text="{Binding RecipeCode, UpdateSourceTrigger=PropertyChanged}"
                                Padding="12,8"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource DividerBrush}"
                                Margin="0,0,0,12"
                                mah:TextBoxHelper.Watermark="e.g., DONUT-001" />

                        <!-- Recipe Name -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                  Text="Recipe Name:"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,12" />
                        <TextBox Grid.Row="1" Grid.Column="1"
                                Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}"
                                Padding="12,8"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource DividerBrush}"
                                Margin="0,0,0,12"
                                mah:TextBoxHelper.Watermark="e.g., Donut Cokelat" />

                        <!-- Description -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                  Text="Description:"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  VerticalAlignment="Top"
                                  Margin="0,0,12,12" />
                        <TextBox Grid.Row="2" Grid.Column="1"
                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                Padding="12,8"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource DividerBrush}"
                                Height="80"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Margin="0,0,0,12"
                                mah:TextBoxHelper.Watermark="Enter recipe description..." />

                        <!-- Yield Per Batch -->
                        <TextBlock Grid.Row="3" Grid.Column="0"
                                  Text="Yield per Batch:"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,12" />
                        <StackPanel Grid.Row="3" Grid.Column="1"
                                   Orientation="Horizontal"
                                   Margin="0,0,0,12">
                            <TextBox Width="120"
                                    Text="{Binding YieldPerBatch, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                    Padding="12,8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource MaterialDesignBody}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    Margin="0,0,12,0" />
                            <ComboBox Width="100"
                                     ItemsSource="{Binding AvailableUnits}"
                                     SelectedValue="{Binding SelectedYieldUnitId}"
                                     SelectedValuePath="Id"
                                     DisplayMemberPath="Code"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource MaterialDesignBody}"
                                     Padding="12,8"
                                     Margin="0,0,0,0" />
                        </StackPanel>

                        <!-- Estimated Production Time -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                  Text="Est. Prod. Time (min):"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,12" />
                        <TextBox Grid.Row="4" Grid.Column="1"
                                Text="{Binding EstimatedProductionTime, UpdateSourceTrigger=PropertyChanged}"
                                Padding="12,8"
                                Background="{DynamicResource SurfaceBrush}"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource DividerBrush}"
                                Width="120"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12" />

                        <!-- Is Active -->
                        <TextBlock Grid.Row="5" Grid.Column="0"
                                  Text="Status:"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />
                        <CheckBox Grid.Row="5" Grid.Column="1"
                                 Content="Active"
                                 IsChecked="{Binding IsActive}"
                                 Foreground="{DynamicResource MaterialDesignBody}"
                                 Margin="0,0,0,0" />
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Ingredients -->
            <TabItem Header="Ingredients">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Add Ingredient Section -->
                    <Border Grid.Row="0"
                           Background="{DynamicResource MaterialDesignCardBackground}"
                           Padding="12"
                           CornerRadius="4"
                           Margin="0,0,0,12"
                           BorderBrush="{DynamicResource DividerBrush}"
                           BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox Grid.Column="0"
                                     ItemsSource="{Binding AvailableIngredients}"
                                     SelectedItem="{Binding SelectedIngredient}"
                                     DisplayMemberPath="Name"
                                     SelectedValuePath="Id"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource MaterialDesignBody}"
                                     Padding="12,8"
                                     Margin="0,0,12,0" />

                            <TextBox Grid.Column="1"
                                    Text="{Binding SelectedIngredientQty, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                                    Width="100"
                                    Padding="12,8"
                                    Background="{DynamicResource SurfaceBrush}"
                                    Foreground="{DynamicResource MaterialDesignBody}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    Margin="0,0,12,0"
                                    mah:TextBoxHelper.Watermark="Qty" />

                            <ComboBox Grid.Column="2"
                                     ItemsSource="{Binding AvailableUnits}"
                                     SelectedValue="{Binding SelectedIngredientUnitId}"
                                     SelectedValuePath="Id"
                                     DisplayMemberPath="Code"
                                     Width="90"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource MaterialDesignBody}"
                                     Padding="12,8"
                                     Margin="0,0,12,0" />

                            <Button Grid.Column="3"
                                   Command="{Binding AddIngredientToRecipeCommand}"
                                   Content="Add"
                                   Padding="16,8"
                                   Background="{DynamicResource SuccessBrush}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Margin="0,0,8,0" />

                            <TextBlock Grid.Column="4"
                                      Text="(Recipe must exist first)"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                                      FontSize="11"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Ingredients List -->
                    <TextBlock Grid.Row="1"
                              Text="Recipe Ingredients"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              Margin="0,0,0,8" />

                    <DataGrid Grid.Row="2"
                             ItemsSource="{Binding Ingredients}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             CanUserDeleteRows="False"
                             ColumnHeaderStyle="{DynamicResource RecipeGridHeaderStyle}"
                             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}"
                             Background="{DynamicResource SurfaceBrush}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource DividerBrush}"
                             CellStyle="{DynamicResource RecipeGridCellStyle}"
                             RowBackground="{DynamicResource MaterialDesignPaper}">
                        <DataGrid.Resources>
                            <Style x:Key="RecipeGridHeaderStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                            </Style>
                            <Style x:Key="RecipeGridTextStyle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                            </Style>
                            <Style x:Key="RecipeGridCellStyle" TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                            </Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ingredient"
                                               Binding="{Binding IngredientName}"
                                               Width="*"
                                               ElementStyle="{StaticResource RecipeGridTextStyle}"
                                               IsReadOnly="True" />
                            <DataGridTextColumn Header="Qty"
                                               Binding="{Binding QuantityPerBatch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                               Width="90"
                                               ElementStyle="{StaticResource RecipeGridTextStyle}" />
                            <DataGridComboBoxColumn Header="Unit"
                                                   SelectedValueBinding="{Binding UnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   SelectedValuePath="Id"
                                                   DisplayMemberPath="Code"
                                                   ItemsSource="{Binding DataContext.AvailableUnits, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   Width="90" />
                            <DataGridTemplateColumn Header="Action" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.UpdateIngredientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding .}"
                                                   Content="Update"
                                                   Padding="8,4"
                                                   FontSize="11"
                                                   Background="{DynamicResource PrimaryHueMidBrush}"
                                                   Foreground="White"
                                                   BorderThickness="0"
                                                   Margin="0,0,6,0" />
                                            <Button Command="{Binding DataContext.RemoveIngredientCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                   CommandParameter="{Binding .}"
                                                   Content="Remove"
                                                   Padding="8,4"
                                                   FontSize="11"
                                                   Background="{DynamicResource DangerBrush}"
                                                   Foreground="White"
                                                   BorderThickness="0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3"
                              Text="{Binding StatusMessage}"
                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                              FontSize="11"
                              Margin="0,12,0,0" />
                </Grid>
            </TabItem>

            <!-- Tab 3: Versions -->
            <TabItem Header="Version History">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox Grid.Row="0"
                            Text="{Binding VersionNotes, UpdateSourceTrigger=PropertyChanged}"
                            Height="60"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            Background="{DynamicResource SurfaceBrush}"
                            Foreground="{DynamicResource MaterialDesignBody}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource DividerBrush}"
                            Padding="12,8"
                            Margin="0,0,0,12"
                            mah:TextBoxHelper.Watermark="Change notes (optional)..." />

                    <Button Grid.Row="1"
                           Command="{Binding CreateVersionCommand}"
                           Content="Create New Version"
                           Padding="16,8"
                           Background="{DynamicResource PrimaryHueMidBrush}"
                           Foreground="White"
                           BorderThickness="0"
                           Margin="0,0,0,12"
                           Width="160"
                           HorizontalAlignment="Left" />

                    <ListBox Grid.Row="2"
                            ItemsSource="{Binding RecipeVersions}"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource DividerBrush}"
                            Padding="12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                       Padding="12"
                                       Margin="0,0,0,8"
                                       CornerRadius="4"
                                       BorderBrush="{DynamicResource DividerBrush}"
                                       BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding VersionNumber, StringFormat='Version {0}'}"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource MaterialDesignBody}" />
                                            <TextBlock Text="{Binding EffectiveDate, StringFormat='Effective: {0:g}'}"
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                      FontSize="11"
                                                      Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding ChangeNotes, FallbackValue='(no notes)'}"
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                      FontSize="11"
                                                      Margin="0,4,0,0"
                                                      TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                               Command="{Binding DataContext.RollbackToVersionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                               CommandParameter="{Binding .}"
                                               Content="Rollback"
                                               Padding="12,6"
                                               Background="{DynamicResource DangerBrush}"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Margin="12,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status & Error Messages -->
        <Border Grid.Row="2"
               Background="{DynamicResource MaterialDesignDividerBackground}"
               Padding="16"
               Margin="16,0,16,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                          Text="{Binding ErrorMessage, FallbackValue='Ready'}"
                          Foreground="Red"
                          FontSize="12" />

                <mah:ProgressRing Grid.Column="1"
                                 IsActive="{Binding IsLoading}"
                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                 Margin="8,0,0,0" />
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <Border Grid.Row="3"
               Background="{DynamicResource MaterialDesignCardBackground}"
               Padding="16"
               BorderBrush="{DynamicResource DividerBrush}"
               BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding SaveRecipeCommand}"
                       Content="Save Recipe"
                       Padding="20,8"
                       Background="{DynamicResource SuccessBrush}"
                       Foreground="White"
                       BorderThickness="0"
                       Margin="0,0,8,0" />
                <Button Command="{Binding CloseEditorCommand}"
                       Content="Close"
                       Padding="20,8"
                       Background="{DynamicResource SurfaceAltBrush}"
                       Foreground="White"
                       BorderThickness="0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
