<UserControl x:Class="DonutMS.Views.SKUs.SKUMasterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:child="clr-namespace:MahApps.Metro.SimpleChildWindow;assembly=MahApps.Metro.SimpleChildWindow"
             xmlns:local="clr-namespace:DonutMS.Views.SKUs"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <child:ChildWindow IsOpen="{Binding IsEditorOpen}" OverlayBrush="#88000000">
            <child:ChildWindow.Content>
                <Border Background="{DynamicResource MaterialDesignPaper}"
                        Padding="0"
                        CornerRadius="6"
                        Width="980"
                        MaxHeight="720">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            Padding="16"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding DialogTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}" />
                    </Border>

                    <!-- Content -->
                    <TabControl Grid.Row="1"
                               Margin="16"
                               Background="Transparent"
                               BorderBrush="{DynamicResource DividerBrush}">

                        <!-- Details -->
                        <TabItem Header="SKU Details" IsSelected="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                              Text="SKU Code:"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource MaterialDesignBody}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,12" />
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                            Text="{Binding EditingSku.Code, UpdateSourceTrigger=PropertyChanged}"
                                            Padding="12,8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            Margin="0,0,0,12"
                                            mah:TextBoxHelper.Watermark="e.g., SKU-001" />

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                              Text="Name:"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource MaterialDesignBody}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,12" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                            Text="{Binding EditingSku.Name, UpdateSourceTrigger=PropertyChanged}"
                                            Padding="12,8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            Margin="0,0,0,12"
                                            mah:TextBoxHelper.Watermark="e.g., Donat Cokelat" />

                                    <TextBlock Grid.Row="2" Grid.Column="0"
                                              Text="Category:"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource MaterialDesignBody}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,12" />
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                            Text="{Binding EditingSku.Category, UpdateSourceTrigger=PropertyChanged}"
                                            Padding="12,8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            Margin="0,0,0,12"
                                            mah:TextBoxHelper.Watermark="e.g., Donut / Box" />

                                    <TextBlock Grid.Row="3" Grid.Column="0"
                                              Text="Description:"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource MaterialDesignBody}"
                                              VerticalAlignment="Top"
                                              Margin="0,0,12,12" />
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                            Text="{Binding EditingSku.Description, UpdateSourceTrigger=PropertyChanged}"
                                            Padding="12,8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            Height="80"
                                            TextWrapping="Wrap"
                                            AcceptsReturn="True"
                                            Margin="0,0,0,12" />

                                    <TextBlock Grid.Row="4" Grid.Column="0"
                                              Text="Linked Recipe:"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource MaterialDesignBody}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,12" />
                                    <ComboBox Grid.Row="4" Grid.Column="1"
                                             ItemsSource="{Binding AvailableRecipes}"
                                             SelectedValue="{Binding EditingSku.RecipeId}"
                                             SelectedValuePath="Id"
                                             DisplayMemberPath="Name"
                                             Background="{DynamicResource SurfaceBrush}"
                                             Foreground="{DynamicResource MaterialDesignBody}"
                                             Padding="12,8"
                                             Margin="0,0,0,12" />

                                    <TextBlock Grid.Row="5" Grid.Column="0"
                                              Text="Retail Price:"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource MaterialDesignBody}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,12" />
                                    <TextBox Grid.Row="5" Grid.Column="1"
                                            Text="{Binding EditingSku.RetailPrice, UpdateSourceTrigger=PropertyChanged}"
                                            Padding="12,8"
                                            Background="{DynamicResource SurfaceBrush}"
                                            Foreground="{DynamicResource MaterialDesignBody}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            Width="160"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,12" />

                                    <TextBlock Grid.Row="6" Grid.Column="0"
                                              Text="Status:"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource MaterialDesignBody}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0" />
                                    <CheckBox Grid.Row="6" Grid.Column="1"
                                             Content="Active"
                                             IsChecked="{Binding EditingSku.IsActive}"
                                             Foreground="{DynamicResource MaterialDesignBody}"
                                             Margin="0,0,0,0" />
                                </Grid>
                            </ScrollViewer>
                        </TabItem>
                        <!-- Cost & Versioning -->
                        <TabItem Header="Cost &amp; Versioning">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                       Background="{DynamicResource MaterialDesignCardBackground}"
                                       Padding="12"
                                       CornerRadius="4"
                                       BorderBrush="{DynamicResource DividerBrush}"
                                       BorderThickness="1"
                                       Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox Grid.Column="0"
                                                Text="{Binding PackagingCostInput, UpdateSourceTrigger=PropertyChanged}"
                                                Width="120"
                                                Padding="10,6"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                Margin="0,0,12,0"
                                                mah:TextBoxHelper.Watermark="Packaging" />

                                        <TextBox Grid.Column="1"
                                                Text="{Binding LaborCostInput, UpdateSourceTrigger=PropertyChanged}"
                                                Width="120"
                                                Padding="10,6"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                Margin="0,0,12,0"
                                                mah:TextBoxHelper.Watermark="Labor" />

                                        <TextBox Grid.Column="2"
                                                Text="{Binding OverheadCostInput, UpdateSourceTrigger=PropertyChanged}"
                                                Width="120"
                                                Padding="10,6"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                Margin="0,0,12,0"
                                                mah:TextBoxHelper.Watermark="Overhead" />

                                        <Button Grid.Column="3"
                                               Command="{Binding AddCostVersionCommand}"
                                               Content="Add Cost Version"
                                               Padding="14,8"
                                               Background="{DynamicResource PrimaryHueMidBrush}"
                                               Foreground="White"
                                               BorderThickness="0"
                                               Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MaterialCostPreview, StringFormat='Material: Rp {0:N0}'}"
                                                      Foreground="{DynamicResource MaterialDesignBody}"
                                                      FontSize="11" />
                                            <TextBlock Text="{Binding EditingSku.HPP, StringFormat='Current HPP: Rp {0:N0}'}"
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                      FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="1"
                                          Text="Cost Version History"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                          Margin="0,0,0,8" />

                                <DataGrid Grid.Row="2"
                                         ItemsSource="{Binding CostHistory}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         CanUserDeleteRows="False"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource MaterialDesignBody}"
                                         TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource DividerBrush}"
                                         RowBackground="{DynamicResource MaterialDesignPaper}"
                                         AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                        </Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Effective"
                                                           Binding="{Binding EffectiveDate, StringFormat=dd MMM yyyy}"
                                                           Width="110"
                                                           IsReadOnly="True" />
                                        <DataGridTextColumn Header="Material"
                                                           Binding="{Binding MaterialCost, Converter={StaticResource CurrencyConverter}}"
                                                           Width="110"
                                                           IsReadOnly="True" />
                                        <DataGridTextColumn Header="Packaging"
                                                           Binding="{Binding PackagingCost, Converter={StaticResource CurrencyConverter}}"
                                                           Width="110"
                                                           IsReadOnly="True" />
                                        <DataGridTextColumn Header="Labor"
                                                           Binding="{Binding LaborCost, Converter={StaticResource CurrencyConverter}}"
                                                           Width="90"
                                                           IsReadOnly="True" />
                                        <DataGridTextColumn Header="Overhead"
                                                           Binding="{Binding OverheadCost, Converter={StaticResource CurrencyConverter}}"
                                                           Width="100"
                                                           IsReadOnly="True" />
                                        <DataGridTextColumn Header="Total HPP"
                                                           Binding="{Binding TotalHPP, Converter={StaticResource CurrencyConverter}}"
                                                           Width="110"
                                                           IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Header="Active"
                                                               Binding="{Binding IsActive}"
                                                               Width="60"
                                                               IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                        <!-- Allergens -->
                        <TabItem Header="Allergens">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                          Text="Select allergens for this SKU. Use 'Trace' for potential cross-contamination."
                                          Foreground="{DynamicResource MaterialDesignBodyLight}"
                                          FontSize="12"
                                          Margin="0,0,0,12" />

                                <ScrollViewer Grid.Row="1">
                                    <ItemsControl ItemsSource="{Binding AvailableAllergens}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                                                       BorderBrush="{DynamicResource DividerBrush}"
                                                       BorderThickness="1"
                                                       CornerRadius="4"
                                                       Padding="10"
                                                       Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox Grid.Column="0"
                                                                 Content="{Binding Name}"
                                                                 IsChecked="{Binding IsSelected}"
                                                                 Foreground="{DynamicResource MaterialDesignBody}" />

                                                        <CheckBox Grid.Column="1"
                                                                 Content="Trace"
                                                                 IsChecked="{Binding MayContainTrace}"
                                                                 Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                                 Margin="12,0,0,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Button Grid.Row="2"
                                       Command="{Binding SaveAllergensCommand}"
                                       Content="Save Allergens"
                                       Padding="16,8"
                                       Background="{DynamicResource PrimaryHueMidBrush}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       HorizontalAlignment="Right"
                                       Margin="0,12,0,0" />
                            </Grid>
                        </TabItem>

                        <!-- Nutrition -->
                        <TabItem Header="Nutrition">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                          Text="Calories:"
                                          Margin="0,0,12,12"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                        Text="{Binding Nutrition.Calories, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12"
                                        Padding="10,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource MaterialDesignBody}" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                          Text="Protein (g):"
                                          Margin="0,0,12,12"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                                <TextBox Grid.Row="1" Grid.Column="1"
                                        Text="{Binding Nutrition.Protein, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12"
                                        Padding="10,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource MaterialDesignBody}" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                          Text="Fat (g):"
                                          Margin="0,0,12,12"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                                <TextBox Grid.Row="2" Grid.Column="1"
                                        Text="{Binding Nutrition.Fat, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12"
                                        Padding="10,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource MaterialDesignBody}" />

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                          Text="Carbs (g):"
                                          Margin="0,0,12,12"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                                <TextBox Grid.Row="3" Grid.Column="1"
                                        Text="{Binding Nutrition.Carbohydrates, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12"
                                        Padding="10,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource MaterialDesignBody}" />

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                          Text="Fiber (g):"
                                          Margin="0,0,12,12"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                                <TextBox Grid.Row="4" Grid.Column="1"
                                        Text="{Binding Nutrition.Fiber, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12"
                                        Padding="10,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource MaterialDesignBody}" />

                                <TextBlock Grid.Row="5" Grid.Column="0"
                                          Text="Sugar (g):"
                                          Margin="0,0,12,12"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                                <TextBox Grid.Row="5" Grid.Column="1"
                                        Text="{Binding Nutrition.Sugar, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12"
                                        Padding="10,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource MaterialDesignBody}" />

                                <TextBlock Grid.Row="6" Grid.Column="0"
                                          Text="Sodium (mg):"
                                          Margin="0,0,12,12"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                                <TextBox Grid.Row="6" Grid.Column="1"
                                        Text="{Binding Nutrition.Sodium, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12"
                                        Padding="10,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource MaterialDesignBody}" />

                                <TextBlock Grid.Row="7" Grid.Column="0"
                                          Text="Serving Size:"
                                          Margin="0,0,12,12"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                                <TextBox Grid.Row="7" Grid.Column="1"
                                        Text="{Binding Nutrition.ServingSize, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,12"
                                        Padding="10,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource MaterialDesignBody}" />

                                <TextBlock Grid.Row="8" Grid.Column="0"
                                          Text="Servings/Pack:"
                                          Margin="0,0,12,0"
                                          Foreground="{DynamicResource MaterialDesignBody}" />
                                <TextBox Grid.Row="8" Grid.Column="1"
                                        Text="{Binding Nutrition.ServingsPerPackage, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,0,0,0"
                                        Padding="10,6"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource MaterialDesignBody}" />

                                <Button Grid.Row="9" Grid.Column="1"
                                       Command="{Binding SaveNutritionCommand}"
                                       Content="Save Nutrition"
                                       Padding="16,8"
                                       Background="{DynamicResource PrimaryHueMidBrush}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       HorizontalAlignment="Right"
                                       Margin="0,16,0,0" />
                            </Grid>
                        </TabItem>
                    </TabControl>

                    <!-- Footer -->
                    <Border Grid.Row="2"
                           Background="{DynamicResource MaterialDesignCardBackground}"
                           Padding="12"
                           BorderBrush="{DynamicResource DividerBrush}"
                           BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding SaveSkuCommand}"
                                   Content="Save SKU"
                                   Padding="18,8"
                                   Background="{DynamicResource SuccessBrush}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Margin="0,0,8,0" />
                            <Button Command="{Binding CancelDialogCommand}"
                                   Content="Close"
                                   Padding="18,8"
                                   Background="{DynamicResource SurfaceAltBrush}"
                                   Foreground="White"
                                   BorderThickness="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            </child:ChildWindow.Content>
        </child:ChildWindow>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="SKU &amp; Product Management"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialDesignBody}"
                       Margin="0,0,0,16" />

            <!-- Search & Controls -->
            <Border Grid.Row="1"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    Padding="16"
                    CornerRadius="4"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,8"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource MaterialDesignBody}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource DividerBrush}"
                             Margin="0,0,12,0"
                             mah:TextBoxHelper.Watermark="Search SKU by name or code..." />

                    <Button Grid.Column="1"
                            Command="{Binding SearchSkusCommand}"
                            Content="Search"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            Background="{DynamicResource PrimaryHueMidBrush}"
                            Foreground="White"
                            BorderThickness="0" />

                    <Button Grid.Column="2"
                            Command="{Binding OpenAddDialogCommand}"
                            Content="+ Add SKU"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            Background="{DynamicResource SuccessBrush}"
                            Foreground="White"
                            BorderThickness="0" />

                    <CheckBox Grid.Column="3"
                              Content="Show Inactive"
                              IsChecked="{Binding ShowInactiveOnly}"
                              VerticalAlignment="Center"
                              Foreground="{DynamicResource MaterialDesignBody}" />
                </Grid>
            </Border>

            <!-- DataGrid -->
            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding Skus}"
                      SelectedItem="{Binding SelectedSku}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="{DynamicResource SurfaceBrush}"
                      Foreground="{DynamicResource MaterialDesignBody}"
                      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource DividerBrush}"
                      RowBackground="{DynamicResource MaterialDesignPaper}"
                      AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" IsReadOnly="True" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="Recipe" Binding="{Binding RecipeName}" Width="180" IsReadOnly="True" />
                    <DataGridTextColumn Header="Retail"
                                       Binding="{Binding RetailPrice, Converter={StaticResource CurrencyConverter}}"
                                       Width="110"
                                       IsReadOnly="True" />
                    <DataGridTextColumn Header="HPP"
                                       Binding="{Binding HPP, Converter={StaticResource CurrencyConverter}}"
                                       Width="110"
                                       IsReadOnly="True" />
                    <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding .}"
                                            Content="Edit"
                                            Padding="8,4"
                                            FontSize="11"
                                            Background="{DynamicResource PrimaryHueMidBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="0,0,4,0" />
                                    <Button Command="{Binding DataContext.DeleteSkuCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding .}"
                                            Content="Delete"
                                            Padding="8,4"
                                            FontSize="11"
                                            Background="{DynamicResource DangerBrush}"
                                            Foreground="White"
                                            BorderThickness="0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Status -->
            <Border Grid.Row="3"
                    Background="{DynamicResource MaterialDesignDividerBackground}"
                    Padding="12,8"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerBrush}">
                <TextBlock Text="{Binding StatusMessage}"
                          Foreground="{DynamicResource MaterialDesignBodyLight}"
                          FontSize="12" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
