<UserControl x:Class="DonutMS.Views.PurchaseOrders.PurchaseOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:child="clr-namespace:MahApps.Metro.SimpleChildWindow;assembly=MahApps.Metro.SimpleChildWindow"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <child:ChildWindow IsOpen="{Binding IsDialogOpen}" OverlayBrush="#88000000">
            <child:ChildWindow.Content>
                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                        Padding="16"
                        CornerRadius="6"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        Width="900"
                        MaxHeight="680">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding DialogTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource MaterialDesignBody}" />

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Create PO Panel -->
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DialogMode}" Value="Create">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Supplier" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <ComboBox ItemsSource="{Binding Suppliers}"
                                                      SelectedItem="{Binding SelectedSupplier}"
                                                      DisplayMemberPath="Name"
                                                      Background="{DynamicResource SurfaceBrush}"
                                                      Foreground="{DynamicResource MaterialDesignBody}"
                                                      Margin="0,6,0,0"
                                                      mah:TextBoxHelper.Watermark="Select supplier" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="Required Delivery" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <DatePicker SelectedDate="{Binding RequiredDeliveryDate}" Margin="0,6,0,0" Background="{DynamicResource SurfaceBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="PO Number (optional)" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBox Text="{Binding PoNumber, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,6,0,0"
                                                     Padding="8,6"
                                                     Background="{DynamicResource SurfaceBrush}"
                                                     Foreground="{DynamicResource MaterialDesignBody}"
                                                     BorderBrush="{DynamicResource DividerBrush}"
                                                     BorderThickness="1" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Delivery Address" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBox Text="{Binding DeliveryAddress, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,6,0,0"
                                                     Padding="8,6"
                                                     Background="{DynamicResource SurfaceBrush}"
                                                     Foreground="{DynamicResource MaterialDesignBody}"
                                                     BorderBrush="{DynamicResource DividerBrush}"
                                                     BorderThickness="1" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="Payment Status" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBox Text="{Binding PaymentStatus, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,6,0,0"
                                                     Padding="8,6"
                                                     Background="{DynamicResource SurfaceBrush}"
                                                     Foreground="{DynamicResource MaterialDesignBody}"
                                                     BorderBrush="{DynamicResource DividerBrush}"
                                                     BorderThickness="1" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Notes" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,6,0,0"
                                                     Padding="8,6"
                                                     Background="{DynamicResource SurfaceBrush}"
                                                     Foreground="{DynamicResource MaterialDesignBody}"
                                                     BorderBrush="{DynamicResource DividerBrush}"
                                                     BorderThickness="1" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Order Items"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"
                                               Margin="0,0,0,8" />

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0"
                                                  ItemsSource="{Binding Ingredients}"
                                                  SelectedItem="{Binding SelectedItemIngredient}"
                                                  DisplayMemberPath="Name"
                                                  Background="{DynamicResource SurfaceBrush}"
                                                  Foreground="{DynamicResource MaterialDesignBody}"
                                                  Margin="0,0,12,0"
                                                  mah:TextBoxHelper.Watermark="Ingredient" />

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ItemQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6"
                                                 Background="{DynamicResource SurfaceBrush}"
                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                 BorderBrush="{DynamicResource DividerBrush}"
                                                 BorderThickness="1"
                                                 Margin="0,0,12,0"
                                                 mah:TextBoxHelper.Watermark="Qty" />

                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding Units}"
                                                  SelectedItem="{Binding SelectedItemUnit}"
                                                  DisplayMemberPath="Code"
                                                  Background="{DynamicResource SurfaceBrush}"
                                                  Foreground="{DynamicResource MaterialDesignBody}"
                                                  Margin="0,0,12,0"
                                                  mah:TextBoxHelper.Watermark="Unit" />

                                        <TextBox Grid.Column="3"
                                                 Text="{Binding ItemUnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6"
                                                 Background="{DynamicResource SurfaceBrush}"
                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                 BorderBrush="{DynamicResource DividerBrush}"
                                                 BorderThickness="1"
                                                 Margin="0,0,12,0"
                                                 mah:TextBoxHelper.Watermark="Unit price" />

                                        <Button Grid.Column="4"
                                                Command="{Binding AddItemCommand}"
                                                Content="Add"
                                                Padding="12,6"
                                                Background="{DynamicResource SuccessBrush}"
                                                Foreground="White"
                                                BorderThickness="0" />
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding EditingItems}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              Background="{DynamicResource SurfaceBrush}"
                                              Foreground="{DynamicResource MaterialDesignBody}"
                                              TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                              BorderThickness="1"
                                              BorderBrush="{DynamicResource DividerBrush}"
                                              RowBackground="{DynamicResource MaterialDesignPaper}"
                                              AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Ingredient" Binding="{Binding IngredientName}" Width="200" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Qty" Binding="{Binding OrderedQuantity, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Unit" Binding="{Binding UnitCode}" Width="60" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="110" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, Converter={StaticResource CurrencyConverter}}" Width="120" IsReadOnly="True" />
                                            <DataGridTemplateColumn Header="Actions" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding .}"
                                                                Content="Remove"
                                                                Padding="8,4"
                                                                Background="{DynamicResource DangerBrush}"
                                                                Foreground="White"
                                                                BorderThickness="0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <TextBlock Text="Total:"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding EditingTotalAmount, Converter={StaticResource CurrencyConverter}}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource MaterialDesignBody}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                        <Button Command="{Binding SavePurchaseOrderCommand}"
                                                Content="Save Purchase Order"
                                                Padding="16,8"
                                                Background="{DynamicResource SuccessBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Margin="0,0,8,0" />
                                        <Button Command="{Binding CloseDialogCommand}"
                                                Content="Close"
                                                Padding="16,8"
                                                Background="{DynamicResource MaterialDesignCardBackground}"
                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Receive PO Panel -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DialogMode}" Value="Receive">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="PO Number" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Text="{Binding SelectedPurchaseOrder.PONumber}"
                                                       Margin="0,6,0,0"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="Supplier" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Text="{Binding SelectedPurchaseOrder.SupplierName}"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Status" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBlock Text="{Binding SelectedPurchaseOrder.Status}"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource MaterialDesignBody}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Receiving Date" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <DatePicker SelectedDate="{Binding ReceivingDate}" Margin="0,6,0,0" Background="{DynamicResource SurfaceBrush}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="Received By" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBox Text="{Binding ReceivedBy, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,6,0,0"
                                                     Padding="8,6"
                                                     Background="{DynamicResource SurfaceBrush}"
                                                     Foreground="{DynamicResource MaterialDesignBody}"
                                                     BorderBrush="{DynamicResource DividerBrush}"
                                                     BorderThickness="1" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Notes" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                            <TextBox Text="{Binding ReceivingNotes, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,6,0,0"
                                                     Padding="8,6"
                                                     Background="{DynamicResource SurfaceBrush}"
                                                     Foreground="{DynamicResource MaterialDesignBody}"
                                                     BorderBrush="{DynamicResource DividerBrush}"
                                                     BorderThickness="1" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Receiving Lines"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource MaterialDesignBody}"
                                               Margin="0,0,0,8" />

                                    <DataGrid ItemsSource="{Binding ReceivingLines}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              Background="{DynamicResource SurfaceBrush}"
                                              Foreground="{DynamicResource MaterialDesignBody}"
                                              TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                              BorderThickness="1"
                                              BorderBrush="{DynamicResource DividerBrush}"
                                              RowBackground="{DynamicResource MaterialDesignPaper}"
                                              AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Ingredient" Binding="{Binding IngredientName}" Width="200" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Ordered" Binding="{Binding OrderedQuantity, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Received" Binding="{Binding ReceivedToDate, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingQuantity, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                            <DataGridTextColumn Header="Unit" Binding="{Binding UnitCode}" Width="60" IsReadOnly="True" />
                                            <DataGridTemplateColumn Header="Receive Qty" Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding ReceiveQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                                 Padding="6,4"
                                                                 Background="{DynamicResource SurfaceBrush}"
                                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                                 BorderBrush="{DynamicResource DividerBrush}"
                                                                 BorderThickness="1" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Batch" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding SupplierBatchNumber, UpdateSourceTrigger=PropertyChanged}"
                                                                 Padding="6,4"
                                                                 Background="{DynamicResource SurfaceBrush}"
                                                                 Foreground="{DynamicResource MaterialDesignBody}"
                                                                 BorderBrush="{DynamicResource DividerBrush}"
                                                                 BorderThickness="1" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Expiry" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <DatePicker SelectedDate="{Binding ExpiryDate}" Background="{DynamicResource SurfaceBrush}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                        <Button Command="{Binding SubmitReceivingCommand}"
                                                Content="Post Receiving"
                                                Padding="16,8"
                                                Background="{DynamicResource SuccessBrush}"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Margin="0,0,8,0" />
                                        <Button Command="{Binding CloseDialogCommand}"
                                                Content="Close"
                                                Padding="16,8"
                                                Background="{DynamicResource MaterialDesignCardBackground}"
                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1" />
                                    </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </child:ChildWindow.Content>
        </child:ChildWindow>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Purchase Orders"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MaterialDesignBody}"
                       Margin="0,0,0,16" />

            <Border Grid.Row="1"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    Padding="16"
                    CornerRadius="4"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total POs" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                        <TextBlock Text="{Binding TotalOrders}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Pending" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                        <TextBlock Text="{Binding PendingOrders}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Overdue" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                        <TextBlock Text="{Binding OverdueOrders}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Total Value" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                        <TextBlock Text="{Binding TotalOrderValue, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding AutoGenerateSupplier}"
                                  DisplayMemberPath="Name"
                                  Width="180"
                                  Background="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  Margin="0,0,8,0"
                                  mah:TextBoxHelper.Watermark="All suppliers" />
                        <Button Command="{Binding AutoGenerateCommand}"
                                Content="Auto Generate"
                                Padding="12,6"
                                Background="{DynamicResource PrimaryHueMidBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,0,8,0" />
                        <Button Command="{Binding OpenCreateDialogCommand}"
                                Content="+ New PO"
                                Padding="12,6"
                                Background="{DynamicResource SuccessBrush}"
                                Foreground="White"
                                BorderThickness="0"
                                Margin="0,0,8,0" />
                        <Button Command="{Binding RefreshCommand}"
                                Content="Refresh"
                                Padding="12,6"
                                Background="{DynamicResource MaterialDesignCardBackground}"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                BorderBrush="{DynamicResource DividerBrush}"
                                BorderThickness="1" />
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid Grid.Row="2"
                      ItemsSource="{Binding PurchaseOrders}"
                      SelectedItem="{Binding SelectedPurchaseOrder}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="{DynamicResource SurfaceBrush}"
                      Foreground="{DynamicResource MaterialDesignBody}"
                      TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource DividerBrush}"
                      RowBackground="{DynamicResource MaterialDesignPaper}"
                      AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PO Number" Binding="{Binding PONumber}" Width="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="180" IsReadOnly="True" />
                    <DataGridTextColumn Header="Order Date" Binding="{Binding OrderDate, StringFormat=dd MMM yyyy}" Width="110" IsReadOnly="True" />
                    <DataGridTextColumn Header="Required" Binding="{Binding RequiredDeliveryDate, StringFormat=dd MMM yyyy}" Width="110" IsReadOnly="True" />
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="120" IsReadOnly="True" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="Actions" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <Button Command="{Binding DataContext.OpenReceiveDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding .}"
                                            Content="Receive"
                                            Padding="8,4"
                                            FontSize="11"
                                            Background="{DynamicResource AccentBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="0,0,4,0" />
                                    <Button Command="{Binding DataContext.ConfirmPurchaseOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding .}"
                                            Content="Confirm"
                                            Padding="8,4"
                                            FontSize="11"
                                            Background="{DynamicResource SuccessBrush}"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Margin="0,0,4,0" />
                                    <Button Command="{Binding DataContext.CancelPurchaseOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding .}"
                                            Content="Cancel"
                                            Padding="8,4"
                                            FontSize="11"
                                            Background="{DynamicResource DangerBrush}"
                                            Foreground="White"
                                            BorderThickness="0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="3"
                    Background="{DynamicResource MaterialDesignDividerBackground}"
                    Padding="12,8"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerBrush}"
                    Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Tomato" FontSize="12" />
                    </StackPanel>

                    <mah:ProgressRing Grid.Column="1"
                                      IsActive="{Binding IsLoading}"
                                      Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
