
<UserControl x:Class="DonutMS.Views.Labor.LaborOverheadViewV2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100">

    <Grid Background="{DynamicResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Labor &amp; Overhead" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />
                <TextBlock Text="Operators, labor rates, batch labor, and overhead allocation" Foreground="{DynamicResource MaterialDesignBodyLight}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Content="Refresh"
                    Padding="12,6"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    Foreground="{DynamicResource MaterialDesignBody}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1" />
        </Grid>

        <TabControl Grid.Row="1" Margin="16,0,16,16" Background="{DynamicResource MaterialDesignPaper}">
            <TabItem Header="Operators">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Operator Details" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />

                            <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <TextBox Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                            <TextBlock Text="Employee ID" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <TextBox Text="{Binding OperatorEmployeeId, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                            <TextBlock Text="Job Title" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <TextBox Text="{Binding OperatorJobTitle, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                            <TextBlock Text="Base Salary" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <TextBox Text="{Binding OperatorBaseSalary, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                            <TextBlock Text="Salary Period" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <ComboBox ItemsSource="{Binding SalaryPeriods}"
                                      SelectedItem="{Binding OperatorSalaryPeriod}"
                                      Background="White" />

                            <TextBlock Text="Hire Date" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <DatePicker SelectedDate="{Binding OperatorHireDate}" Background="White" />

                            <CheckBox Content="Active" IsChecked="{Binding OperatorIsActive}" Margin="0,12,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Command="{Binding SaveOperatorCommand}"
                                        Content="Save"
                                        Padding="12,6"
                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                        Foreground="White"
                                        Margin="0,0,8,0" />
                                <Button Command="{Binding ClearOperatorFormCommand}"
                                        Content="Clear"
                                        Padding="12,6"
                                        Background="{DynamicResource MaterialDesignCardBackground}"
                                        Foreground="{DynamicResource MaterialDesignBody}"
                                        BorderBrush="{DynamicResource DividerBrush}"
                                        BorderThickness="1" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <DataGrid ItemsSource="{Binding Operators}"
                                  SelectedItem="{Binding SelectedOperator}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Background="White"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                  RowBackground="{DynamicResource MaterialDesignPaper}"
                                  AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" IsReadOnly="True" />
                                <DataGridTextColumn Header="Employee ID" Binding="{Binding EmployeeId}" Width="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="Job Title" Binding="{Binding JobTitle}" Width="140" IsReadOnly="True" />
                                <DataGridTextColumn Header="Base Salary" Binding="{Binding BaseSalary, StringFormat=N0}" Width="120" IsReadOnly="True" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Labor Rates">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Add Labor Rate" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />

                            <TextBlock Text="Operator" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <ComboBox ItemsSource="{Binding Operators}"
                                      SelectedItem="{Binding SelectedRateOperator}"
                                      DisplayMemberPath="Name"
                                      Background="White" />

                            <TextBlock Text="Hourly Rate" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <TextBox Text="{Binding RateHourlyRate, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                            <TextBlock Text="Overtime Multiplier" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <TextBox Text="{Binding RateOvertimeMultiplier, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                            <TextBlock Text="Effective Date" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <DatePicker SelectedDate="{Binding RateEffectiveDate}" Background="White" />

                            <TextBlock Text="Shift Type" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <ComboBox ItemsSource="{Binding ShiftTypes}"
                                      SelectedItem="{Binding RateShiftType}"
                                      Background="White" />

                            <Button Command="{Binding AddLaborRateCommand}"
                                    Content="Add Rate"
                                    Padding="12,6"
                                    Margin="0,16,0,0"
                                    Background="{DynamicResource PrimaryHueMidBrush}"
                                    Foreground="White" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <DataGrid ItemsSource="{Binding LaborRates}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Background="White"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                  RowBackground="{DynamicResource MaterialDesignPaper}"
                                  AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorName}" Width="180" IsReadOnly="True" />
                                <DataGridTextColumn Header="Rate" Binding="{Binding HourlyRate, StringFormat=N2}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Overtime" Binding="{Binding OvertimeMultiplier}" Width="90" IsReadOnly="True" />
                                <DataGridTextColumn Header="Shift" Binding="{Binding ShiftType}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Effective" Binding="{Binding EffectiveDate, StringFormat=d}" Width="110" IsReadOnly="True" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Batch Labor">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Record Batch Labor" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />

                            <TextBlock Text="Batch" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <ComboBox ItemsSource="{Binding Batches}"
                                      SelectedItem="{Binding SelectedBatch}"
                                      DisplayMemberPath="BatchCode"
                                      Background="White" />

                            <TextBlock Text="Operator" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <ComboBox ItemsSource="{Binding Operators}"
                                      SelectedItem="{Binding SelectedBatchOperator}"
                                      DisplayMemberPath="Name"
                                      Background="White" />

                            <TextBlock Text="Work Date" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <DatePicker SelectedDate="{Binding BatchLaborDate}" Background="White" />

                            <TextBlock Text="Hours Worked" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <TextBox Text="{Binding BatchHoursWorked, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                            <TextBlock Text="Overtime Hours" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <TextBox Text="{Binding BatchOvertimeHours, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                            <TextBlock Text="Shift Type" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                            <ComboBox ItemsSource="{Binding ShiftTypes}"
                                      SelectedItem="{Binding BatchShiftType}"
                                      Background="White" />

                            <Button Command="{Binding AddBatchLaborCommand}"
                                    Content="Save Labor"
                                    Padding="12,6"
                                    Margin="0,16,0,0"
                                    Background="{DynamicResource PrimaryHueMidBrush}"
                                    Foreground="White" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource MaterialDesignCardBackground}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <DataGrid ItemsSource="{Binding BatchLaborRecords}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Background="White"
                                  Foreground="{DynamicResource MaterialDesignBody}"
                                  TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                  RowBackground="{DynamicResource MaterialDesignPaper}"
                                  AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Operator" Binding="{Binding OperatorName}" Width="180" IsReadOnly="True" />
                                <DataGridTextColumn Header="Hours" Binding="{Binding HoursWorked, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                <DataGridTextColumn Header="Overtime" Binding="{Binding OvertimeHours, StringFormat=N2}" Width="90" IsReadOnly="True" />
                                <DataGridTextColumn Header="Shift" Binding="{Binding ShiftType}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Date" Binding="{Binding StartTime, StringFormat=d}" Width="100" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Overhead">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Utility Expenses" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Utility Entry" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                                    <TextBox Text="{Binding UtilityName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                                    <TextBlock Text="Type" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                                    <ComboBox ItemsSource="{Binding UtilityTypes}"
                                              SelectedItem="{Binding UtilityType}"
                                              Background="White" />

                                    <TextBlock Text="Monthly Amount" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                                    <TextBox Text="{Binding UtilityMonthlyAmount, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                                    <TextBlock Text="Allocation Method" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                                    <ComboBox ItemsSource="{Binding AllocationMethods}"
                                              SelectedItem="{Binding UtilityAllocationMethod}"
                                              Background="White" />

                                    <TextBlock Text="Allocation Value" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                                    <TextBox Text="{Binding UtilityAllocationValue, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                                    <CheckBox Content="Active" IsChecked="{Binding UtilityIsActive}" Margin="0,12,0,0" />

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Command="{Binding SaveUtilityExpenseCommand}"
                                                Content="Save"
                                                Padding="12,6"
                                                Background="{DynamicResource PrimaryHueMidBrush}"
                                                Foreground="White"
                                                Margin="0,0,8,0" />
                                        <Button Command="{Binding ClearUtilityFormCommand}"
                                                Content="Clear"
                                                Padding="12,6"
                                                Background="{DynamicResource MaterialDesignCardBackground}"
                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">
                                <DataGrid ItemsSource="{Binding UtilityExpenses}"
                                          SelectedItem="{Binding SelectedUtilityExpense}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          Background="White"
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                          TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                          RowBackground="{DynamicResource MaterialDesignPaper}"
                                          AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Type" Binding="{Binding UtilityType}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Monthly" Binding="{Binding MonthlyAmount, StringFormat=N0}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Allocation" Binding="{Binding AllocationMethod}" Width="110" IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>

                        <TextBlock Text="Equipment Depreciation" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,24,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="16"
                                    Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="Equipment Entry" FontWeight="SemiBold" Foreground="{DynamicResource MaterialDesignBody}" />

                                    <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                                    <TextBox Text="{Binding EquipmentName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                                    <TextBlock Text="Acquisition Cost" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                                    <TextBox Text="{Binding EquipmentAcquisitionCost, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                                    <TextBlock Text="Depreciation Years" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                                    <TextBox Text="{Binding EquipmentDepreciationYears, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                                    <TextBlock Text="Residual Value" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                                    <TextBox Text="{Binding EquipmentResidualValue, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Background="White" />

                                    <TextBlock Text="Monthly Depreciation" FontSize="11" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,12,0,0" />
                                    <TextBox Text="{Binding EquipmentMonthlyDepreciation}" Padding="8,6" Background="White" IsReadOnly="True" />

                                    <CheckBox Content="Active" IsChecked="{Binding EquipmentIsActive}" Margin="0,12,0,0" />

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Command="{Binding SaveEquipmentCommand}"
                                                Content="Save"
                                                Padding="12,6"
                                                Background="{DynamicResource PrimaryHueMidBrush}"
                                                Foreground="White"
                                                Margin="0,0,8,0" />
                                        <Button Command="{Binding ClearEquipmentFormCommand}"
                                                Content="Clear"
                                                Padding="12,6"
                                                Background="{DynamicResource MaterialDesignCardBackground}"
                                                Foreground="{DynamicResource MaterialDesignBody}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12">
                                <DataGrid ItemsSource="{Binding EquipmentItems}"
                                          SelectedItem="{Binding SelectedEquipment}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          Background="White"
                                          Foreground="{DynamicResource MaterialDesignBody}"
                                          TextElement.Foreground="{DynamicResource MaterialDesignBody}"
                                          RowBackground="{DynamicResource MaterialDesignPaper}"
                                          AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}" />
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Equipment" Binding="{Binding EquipmentName}" Width="170" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Cost" Binding="{Binding AcquisitionCost, StringFormat=N0}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Years" Binding="{Binding DepreciationYears}" Width="70" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Monthly" Binding="{Binding MonthlyDepreciation, StringFormat=N2}" Width="120" IsReadOnly="True" />
                                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="60" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Margin="16,0,16,12"
                   Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
    </Grid>
</UserControl>
